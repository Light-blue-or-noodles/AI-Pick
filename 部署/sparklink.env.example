# SparkLink 生产环境变量（复制到服务器 /opt/sparklink/.env）
# 权限: chmod 600 /opt/sparklink/.env

JWT_SECRET=your-jwt-secret
DB_PASSWORD=your-db-password

DASHSCOPE_API_KEY=sk-your-dashscope-key

DIFY_API_KEY=dataset-your-dify-key
DIFY_DATASET_ID=your-dataset-uuid
DIFY_BASE_URL=https://api.dify.ai/v1

CHAT_TOOLS_ENABLED=true
CHAT_WEB_SEARCH_ENABLED=true
MEMORY_LIBRARY_ENVIRONMENT_TAG=prod

WECHAT_APPID=wx4bdbaf380a183caa
WECHAT_SECRET=your-wechat-secret

TENCENT_IM_SDK_APP_ID=1600133993
TENCENT_IM_IDENTIFIER=administrator
TENCENT_IM_KEY=your-tencent-im-key
TENCENT_IM_EXPIRE_SECONDS=604800
TENCENT_IM_REST_HOST=https://console.tim.qq.com
TENCENT_IM_AVATAR_PUBLIC_BASE=https://www.aipick.cloud/api
TENCENT_IM_AVATAR_PUBLIC_HTTPS=https://www.aipick.cloud/api
