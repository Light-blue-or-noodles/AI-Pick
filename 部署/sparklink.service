[Unit]
Description=SparkLink Backend Service
After=network.target docker.service

[Service]
Type=simple
User=root
WorkingDirectory=/opt/sparklink
EnvironmentFile=-/opt/sparklink/.env
Environment=JAVA_OPTS=-Xmx512m
ExecStart=/usr/bin/java $JAVA_OPTS -jar /opt/sparklink/app.jar --spring.profiles.active=prod
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
