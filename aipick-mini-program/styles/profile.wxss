/* profile.wxss - 我的页样式 */

/* 页面头部 */
.profile-header {
  background: linear-gradient(135deg, var(--primary-color) 0%, var(--primary-light) 100%);
  padding: 60rpx 30rpx 40rpx;
  position: relative;
}

.profile-user {
  display: flex;
  align-items: center;
}

.profile-avatar {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  overflow: hidden;
  border: 4rpx solid rgba(255, 255, 255, 0.3);
  margin-right: 24rpx;
}

.profile-avatar image {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.profile-info {
  flex: 1;
}

.profile-name {
  font-size: 40rpx;
  font-weight: 700;
  color: #FFFFFF;
  margin-bottom: 8rpx;
}

.profile-id {
  font-size: var(--font-sm);
  color: rgba(255, 255, 255, 0.7);
  margin-bottom: 12rpx;
}

.profile-tags {
  display: flex;
}

.profile-tag {
  padding: 6rpx 14rpx;
  font-size: var(--font-xs);
  background: rgba(255, 255, 255, 0.2);
  color: #FFFFFF;
  border-radius: var(--radius-sm);
  margin-right: 10rpx;
}

/* 编辑资料按钮 */
.profile-edit-btn {
  position: absolute;
  top: 30rpx;
  right: 30rpx;
  padding: 12rpx 20rpx;
  background: rgba(255, 255, 255, 0.2);
  color: #FFFFFF;
  font-size: var(--font-sm);
  border-radius: var(--radius-full);
  display: flex;
  align-items: center;
}

.profile-edit-btn image {
  width: 24rpx;
  height: 24rpx;
  margin-right: 6rpx;
}

/* 数据统计 */
.profile-stats {
  display: flex;
  background: var(--bg-white);
  margin: -20rpx 20rpx 20rpx;
  border-radius: var(--radius-lg);
  padding: 30rpx 0;
  box-shadow: var(--shadow-md);
  position: relative;
  z-index: 10;
}

.stat-item {
  flex: 1;
  text-align: center;
  border-right: 1rpx solid var(--border-color);
}

.stat-item:last-child {
  border-right: none;
}

.stat-num {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--primary-color);
  margin-bottom: 6rpx;
}

.stat-label {
  font-size: var(--font-sm);
  color: var(--text-tertiary);
}

/* 功能菜单 */
.profile-menu {
  padding: 10rpx 20rpx;
}

.menu-section {
  background: var(--bg-white);
  border-radius: var(--radius-lg);
  margin-bottom: 20rpx;
  overflow: hidden;
}

.menu-section-title {
  padding: 20rpx 30rpx 10rpx;
  font-size: var(--font-sm);
  color: var(--text-tertiary);
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 28rpx 30rpx;
  border-bottom: 1rpx solid var(--border-color);
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-item:active {
  background: var(--bg-gray);
}

.menu-icon {
  width: 44rpx;
  height: 44rpx;
  margin-right: 20rpx;
}

.menu-icon image {
  width: 100%;
  height: 100%;
}

.menu-text {
  flex: 1;
  font-size: var(--font-base);
  color: var(--text-primary);
}

.menu-arrow {
  width: 24rpx;
  height: 24rpx;
  opacity: 0.4;
}

.menu-badge {
  padding: 6rpx 12rpx;
  background: var(--error-color);
  color: var(--text-inverse);
  font-size: 20rpx;
  border-radius: var(--radius-full);
  margin-right: 10rpx;
}

/* 我的搭子 */
.my-partners {
  padding: 20rpx;
}

.partner-section-title {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.partner-title {
  font-size: var(--font-lg);
  font-weight: 600;
  color: var(--text-primary);
}

.partner-more {
  font-size: var(--font-sm);
  color: var(--primary-color);
}

.partner-list-horizontal {
  display: flex;
  overflow-x: auto;
  padding-bottom: 10rpx;
}

.partner-card-mini {
  width: 180rpx;
  flex-shrink: 0;
  margin-right: 20rpx;
  text-align: center;
}

.partner-avatar-mini {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  overflow: hidden;
  margin: 0 auto 12rpx;
}

.partner-avatar-mini image {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.partner-name-mini {
  font-size: var(--font-sm);
  color: var(--text-primary);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* 我的活动 */
.my-activities {
  padding: 20rpx;
}

.activity-tabs {
  display: flex;
  background: var(--bg-white);
  border-radius: var(--radius-lg);
  padding: 8rpx;
  margin-bottom: 20rpx;
}

.activity-tab {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  font-size: var(--font-base);
  color: var(--text-secondary);
  border-radius: var(--radius-md);
}

.activity-tab.active {
  background: var(--primary-color);
  color: var(--text-inverse);
  font-weight: 500;
}

.activity-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.activity-card-mini {
  width: 48%;
  background: var(--bg-white);
  border-radius: var(--radius-lg);
  overflow: hidden;
  margin-bottom: 20rpx;
  box-shadow: var(--shadow-sm);
}

.activity-cover-mini {
  width: 100%;
  height: 200rpx;
}

.activity-cover-mini image {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.activity-info-mini {
  padding: 16rpx;
}

.activity-title-mini {
  font-size: var(--font-sm);
  font-weight: 500;
  color: var(--text-primary);
  margin-bottom: 8rpx;
  display: -webkit-box;
  -webkit-line-clamp: 1;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.activity-status-mini {
  font-size: var(--font-xs);
  display: flex;
  align-items: center;
}

.status-dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  margin-right: 6rpx;
}

.status-dot.ongoing {
  background: var(--success-color);
}

.status-dot.ended {
  background: var(--text-tertiary);
}

/* 设置页 */
.settings-section {
  background: var(--bg-white);
  border-radius: var(--radius-lg);
  margin-bottom: 20rpx;
  overflow: hidden;
}

.settings-item {
  display: flex;
  align-items: center;
  padding: 28rpx 30rpx;
  border-bottom: 1rpx solid var(--border-color);
}

.settings-item:last-child {
  border-bottom: none;
}

.settings-icon {
  width: 44rpx;
  height: 44rpx;
  margin-right: 20rpx;
}

.settings-text {
  flex: 1;
  font-size: var(--font-base);
  color: var(--text-primary);
}

.settings-arrow {
  width: 24rpx;
  height: 24rpx;
  opacity: 0.4;
}

.settings-toggle {
  width: 96rpx;
  height: 52rpx;
  background: var(--border-color);
  border-radius: 26rpx;
  position: relative;
  transition: background 0.3s;
}

.settings-toggle.active {
  background: var(--primary-color);
}

.toggle-handle {
  width: 48rpx;
  height: 48rpx;
  background: var(--bg-white);
  border-radius: 50%;
  position: absolute;
  top: 2rpx;
  left: 2rpx;
  transition: left 0.3s;
}

.settings-toggle.active .toggle-handle {
  left: 46rpx;
}

/* 退出登录 */
.logout-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--bg-white);
  border-radius: var(--radius-lg);
  padding: 28rpx;
  margin: 20rpx;
}

.logout-btn text {
  font-size: var(--font-base);
  color: var(--error-color);
}

/* 底部版权 */
.profile-footer {
  text-align: center;
  padding: 40rpx 0;
}

.footer-text {
  font-size: var(--font-xs);
  color: var(--text-tertiary);
  margin-bottom: 8rpx;
}

.footer-version {
  font-size: var(--font-xs);
  color: var(--text-disabled);
}

/* 编辑资料页 */
.edit-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 30rpx;
  background: var(--bg-white);
  border-bottom: 1rpx solid var(--border-color);
}

.edit-cancel {
  font-size: var(--font-base);
  color: var(--text-secondary);
}

.edit-title {
  font-size: var(--font-lg);
  font-weight: 600;
}

.edit-save {
  font-size: var(--font-base);
  color: var(--primary-color);
  font-weight: 500;
}

.edit-form {
  padding: 30rpx;
}

.form-item {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--border-color);
}

.form-label {
  width: 160rpx;
  font-size: var(--font-base);
  color: var(--text-primary);
}

.form-input {
  flex: 1;
  font-size: var(--font-base);
  color: var(--text-primary);
}

.form-input::placeholder {
  color: var(--text-tertiary);
}

/* 头像上传 */
.avatar-upload {
  display: flex;
  align-items: center;
  padding: 30rpx;
  background: var(--bg-white);
  margin-bottom: 20rpx;
}

.avatar-preview {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  overflow: hidden;
  margin-right: 20rpx;
}

.avatar-preview image {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.avatar-tip {
  font-size: var(--font-sm);
  color: var(--text-tertiary);
}