/* home.wxss - 首页样式 */

/* 顶部搜索区域 */
.home-header {
  background: linear-gradient(135deg, #FF6B35 0%, #FF8C42 100%);
  padding: 30rpx 30rpx 40rpx;
  position: sticky;
  top: 0;
  z-index: 100;
}

.home-title {
  color: #FFFFFF;
  font-size: 44rpx;
  font-weight: 700;
  margin-bottom: 24rpx;
}

.home-subtitle {
  color: rgba(255, 255, 255, 0.85);
  font-size: 26rpx;
  margin-bottom: 24rpx;
}

/* 搜索框 */
.search-box {
  display: flex;
  align-items: center;
  background: rgba(255, 255, 255, 0.95);
  border-radius: 50rpx;
  padding: 20rpx 30rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.1);
}

.search-icon {
  width: 36rpx;
  height: 36rpx;
  margin-right: 16rpx;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: var(--text-primary);
}

.search-input::placeholder {
  color: var(--text-tertiary);
}

/* 功能入口 */
.quick-actions {
  display: flex;
  justify-content: space-around;
  padding: 30rpx 20rpx;
  background: var(--bg-white);
  margin: 20rpx;
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-sm);
}

.action-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.action-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: var(--secondary-color);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 12rpx;
}

.action-icon image {
  width: 40rpx;
  height: 40rpx;
}

.action-text {
  font-size: var(--font-sm);
  color: var(--text-secondary);
}

/* 轮播图 */
.swiper-container {
  margin: 20rpx;
}

.swiper {
  height: 280rpx;
  border-radius: var(--radius-lg);
  overflow: hidden;
}

.swiper-item {
  width: 100%;
  height: 100%;
}

.swiper-item image {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

/* 区块标题 */
.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 30rpx 30rpx 20rpx;
}

.section-title {
  font-size: var(--font-lg);
  font-weight: 600;
  color: var(--text-primary);
}

.section-more {
  font-size: var(--font-sm);
  color: var(--primary-color);
}

/* 推荐搭子卡片 */
.partner-list {
  padding: 0 20rpx;
}

.partner-card {
  background: var(--bg-white);
  border-radius: var(--radius-lg);
  padding: 24rpx;
  margin-bottom: 20rpx;
  display: flex;
  box-shadow: var(--shadow-sm);
}

.partner-avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  overflow: hidden;
  flex-shrink: 0;
  margin-right: 20rpx;
}

.partner-avatar image {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.partner-info {
  flex: 1;
}

.partner-name {
  font-size: var(--font-base);
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 8rpx;
}

.partner-tags {
  display: flex;
  flex-wrap: wrap;
  margin-bottom: 12rpx;
}

.partner-tag {
  padding: 6rpx 12rpx;
  font-size: var(--font-xs);
  border-radius: var(--radius-sm);
  background: var(--secondary-color);
  color: var(--primary-color);
  margin-right: 8rpx;
  margin-bottom: 8rpx;
}

.partner-desc {
  font-size: var(--font-sm);
  color: var(--text-secondary);
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.partner-meta {
  display: flex;
  align-items: center;
  margin-top: 12rpx;
}

.partner-meta text {
  font-size: var(--font-xs);
  color: var(--text-tertiary);
  margin-right: 20rpx;
}

/* 活动卡片 */
.activity-list {
  padding: 0 20rpx;
}

.activity-card {
  background: var(--bg-white);
  border-radius: var(--radius-lg);
  overflow: hidden;
  margin-bottom: 20rpx;
  box-shadow: var(--shadow-sm);
}

.activity-cover {
  width: 100%;
  height: 300rpx;
}

.activity-cover image {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.activity-info {
  padding: 20rpx;
}

.activity-title {
  font-size: var(--font-base);
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 12rpx;
}

.activity-meta {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
}

.activity-meta-item {
  display: flex;
  align-items: center;
  font-size: var(--font-xs);
  color: var(--text-tertiary);
  margin-right: 20rpx;
  margin-bottom: 8rpx;
}

.activity-meta-item image {
  width: 24rpx;
  height: 24rpx;
  margin-right: 6rpx;
}

.activity-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 20rpx;
  border-top: 1rpx solid var(--border-color);
}

.activity-price {
  font-size: var(--font-lg);
  font-weight: 600;
  color: var(--accent-color);
}

.activity-price text {
  font-size: var(--font-xs);
  font-weight: 400;
}

.activity-joined {
  font-size: var(--font-sm);
  color: var(--text-tertiary);
}

/* 底部推荐 */
.recommend-section {
  padding: 20rpx;
}

.recommend-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.recommend-item {
  width: 48%;
  background: var(--bg-white);
  border-radius: var(--radius-lg);
  overflow: hidden;
  margin-bottom: 20rpx;
  box-shadow: var(--shadow-sm);
}

.recommend-cover {
  width: 100%;
  height: 200rpx;
}

.recommend-cover image {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.recommend-info {
  padding: 16rpx;
}

.recommend-title {
  font-size: var(--font-sm);
  font-weight: 500;
  color: var(--text-primary);
  margin-bottom: 8rpx;
  display: -webkit-box;
  -webkit-line-clamp: 1;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.recommend-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.recommend-price {
  font-size: var(--font-base);
  color: var(--accent-color);
  font-weight: 600;
}

/* 悬浮按钮 */
.fab {
  position: fixed;
  right: 30rpx;
  bottom: 100rpx;
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #FF6B9D 0%, #FF8FB3 100%);
  box-shadow: var(--shadow-lg);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 90;
}

.fab image {
  width: 48rpx;
  height: 48rpx;
}

/* 标签筛选 */
.tag-filter {
  display: flex;
  padding: 20rpx;
  background: var(--bg-white);
  overflow-x: auto;
  white-space: nowrap;
  margin-bottom: 10rpx;
}

.tag-filter-item {
  padding: 12rpx 24rpx;
  font-size: var(--font-sm);
  border-radius: var(--radius-full);
  background: var(--bg-gray);
  color: var(--text-secondary);
  margin-right: 16rpx;
  flex-shrink: 0;
}

.tag-filter-item.active {
  background: var(--primary-color);
  color: var(--text-inverse);
}