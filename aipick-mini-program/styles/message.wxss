/* message.wxss - 消息页样式 */

/* 页面头部 */
.message-header {
  background: linear-gradient(135deg, #FF6B35 0%, #FF8C42 100%);
  padding: 40rpx 30rpx;
}

.message-title {
  color: #FFFFFF;
  font-size: 44rpx;
  font-weight: 700;
}

/* 消息类型tabs */
.message-tabs {
  display: flex;
  background: var(--bg-white);
  padding: 20rpx 30rpx;
  margin-bottom: 10rpx;
}

.message-tab {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  font-size: var(--font-base);
  color: var(--text-secondary);
  position: relative;
}

.message-tab.active {
  color: var(--primary-color);
  font-weight: 600;
}

.message-tab.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 40rpx;
  height: 4rpx;
  background: var(--primary-color);
  border-radius: 2rpx;
}

/* 消息列表 */
.message-list {
  padding: 0;
}

.message-item {
  display: flex;
  align-items: center;
  background: var(--bg-white);
  padding: 24rpx 30rpx;
  border-bottom: 1rpx solid var(--border-color);
}

.message-item:active {
  background: var(--bg-gray);
}

.message-avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  overflow: hidden;
  flex-shrink: 0;
  margin-right: 20rpx;
  position: relative;
}

.message-avatar image {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.message-badge {
  position: absolute;
  top: -4rpx;
  right: -4rpx;
  min-width: 32rpx;
  height: 32rpx;
  padding: 0 8rpx;
  background: var(--error-color);
  color: var(--text-inverse);
  font-size: 20rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.message-content {
  flex: 1;
  min-width: 0;
}

.message-header-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.message-sender {
  font-size: var(--font-base);
  font-weight: 600;
  color: var(--text-primary);
}

.message-time {
  font-size: var(--font-xs);
  color: var(--text-tertiary);
}

.message-text {
  font-size: var(--font-sm);
  color: var(--text-secondary);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* 未读消息 */
.message-item.unread .message-sender {
  font-weight: 700;
}

.message-item.unread .message-text {
  color: var(--text-primary);
}

/* 系统消息 */
.message-system {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 30rpx;
}

.message-system-icon {
  width: 80rpx;
  height: 80rpx;
  margin-bottom: 16rpx;
}

.message-system-text {
  font-size: var(--font-sm);
  color: var(--text-tertiary);
  text-align: center;
}

/* 会话详情 */
.chat-container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: var(--bg-gray);
}

.chat-header {
  background: var(--bg-white);
  padding: 20rpx 30rpx;
  display: flex;
  align-items: center;
  border-bottom: 1rpx solid var(--border-color);
}

.chat-back {
  width: 48rpx;
  height: 48rpx;
  margin-right: 20rpx;
}

.chat-title {
  font-size: var(--font-lg);
  font-weight: 600;
  flex: 1;
}

.chat-more {
  width: 48rpx;
  height: 48rpx;
}

/* 聊天消息区域 */
.chat-messages {
  flex: 1;
  padding: 20rpx;
  overflow-y: auto;
}

.chat-date {
  text-align: center;
  font-size: var(--font-xs);
  color: var(--text-tertiary);
  padding: 20rpx 0;
}

.chat-message {
  display: flex;
  margin-bottom: 30rpx;
  align-items: flex-start;
}

.chat-message.self {
  flex-direction: row-reverse;
}

.chat-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  overflow: hidden;
  flex-shrink: 0;
}

.chat-avatar image {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.chat-bubble {
  max-width: 480rpx;
  padding: 20rpx 24rpx;
  border-radius: var(--radius-lg);
  margin: 0 16rpx;
  position: relative;
}

.chat-message:not(.self) .chat-bubble {
  background: var(--bg-white);
  border-top-left-radius: 8rpx;
}

.chat-message.self .chat-bubble {
  background: var(--primary-color);
  color: var(--text-inverse);
  border-top-right-radius: 8rpx;
}

.chat-text {
  font-size: var(--font-base);
  line-height: 1.5;
  word-break: break-word;
}

.chat-time {
  font-size: var(--font-xs);
  margin-top: 8rpx;
  opacity: 0.7;
}

/* 聊天输入区域 */
.chat-input-area {
  background: var(--bg-white);
  padding: 20rpx 30rpx;
  display: flex;
  align-items: flex-end;
  border-top: 1rpx solid var(--border-color);
}

.chat-input {
  flex: 1;
  background: var(--bg-gray);
  border-radius: var(--radius-lg);
  padding: 16rpx 20rpx;
  font-size: var(--font-base);
  max-height: 200rpx;
  overflow-y: auto;
}

.chat-send-btn {
  width: 80rpx;
  height: 64rpx;
  background: var(--primary-color);
  border-radius: var(--radius-full);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-left: 16rpx;
}

.chat-send-btn image {
  width: 36rpx;
  height: 36rpx;
}

/* 快捷回复 */
.quick-replies {
  display: flex;
  flex-wrap: wrap;
  padding: 16rpx 20rpx;
  background: var(--bg-white);
  border-top: 1rpx solid var(--border-color);
}

.quick-reply {
  padding: 12rpx 20rpx;
  background: var(--secondary-color);
  color: var(--primary-color);
  font-size: var(--font-sm);
  border-radius: var(--radius-full);
  margin: 8rpx;
}

/* 消息提醒 */
.notification-list {
  padding: 0;
}

.notification-item {
  display: flex;
  align-items: flex-start;
  padding: 24rpx 30rpx;
  background: var(--bg-white);
  border-bottom: 1rpx solid var(--border-color);
}

.notification-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: var(--secondary-color);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.notification-icon image {
  width: 32rpx;
  height: 32rpx;
}

.notification-content {
  flex: 1;
}

.notification-title {
  font-size: var(--font-base);
  font-weight: 500;
  color: var(--text-primary);
  margin-bottom: 6rpx;
}

.notification-desc {
  font-size: var(--font-sm);
  color: var(--text-secondary);
  margin-bottom: 8rpx;
}

.notification-time {
  font-size: var(--font-xs);
  color: var(--text-tertiary);
}

/* 空状态 */
.message-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 150rpx 0;
}

.message-empty image {
  width: 250rpx;
  height: 250rpx;
  margin-bottom: 30rpx;
  opacity: 0.5;
}

.message-empty text {
  font-size: var(--font-base);
  color: var(--text-tertiary);
}

/* 搜索消息 */
.message-search {
  padding: 20rpx;
  background: var(--bg-white);
  margin-bottom: 10rpx;
}

.search-input-wrap {
  display: flex;
  align-items: center;
  background: var(--bg-gray);
  border-radius: var(--radius-full);
  padding: 16rpx 24rpx;
}

.search-input-wrap image {
  width: 32rpx;
  height: 32rpx;
  margin-right: 12rpx;
}

.search-input-wrap input {
  flex: 1;
  font-size: var(--font-base);
}