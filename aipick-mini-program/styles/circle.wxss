/* circle.wxss - 活动页样式 */

/* 页面头部 */
.circle-header {
  background: linear-gradient(135deg, #FF6B35 0%, #FF8C42 100%);
  padding: 40rpx 30rpx;
}

.circle-title {
  color: #FFFFFF;
  font-size: 44rpx;
  font-weight: 700;
  margin-bottom: 12rpx;
}

.circle-subtitle {
  color: rgba(255, 255, 255, 0.8);
  font-size: var(--font-base);
}

/* 分类标签 */
.category-tabs {
  display: flex;
  background: var(--bg-white);
  padding: 20rpx 30rpx;
  overflow-x: auto;
  white-space: nowrap;
  margin-bottom: 10rpx;
}

.tab-item {
  padding: 14rpx 28rpx;
  font-size: var(--font-sm);
  color: var(--text-secondary);
  background: var(--bg-gray);
  border-radius: var(--radius-full);
  margin-right: 16rpx;
  flex-shrink: 0;
}

.tab-item.active {
  background: var(--primary-color);
  color: var(--text-inverse);
}

/* 活动列表容器 */
.circle-content {
  padding: 20rpx;
}

/* 活动卡片 - 大图模式 */
.activity-card-large {
  background: var(--bg-white);
  border-radius: var(--radius-lg);
  overflow: hidden;
  margin-bottom: 24rpx;
  box-shadow: var(--shadow-sm);
}

.activity-cover-large {
  width: 100%;
  height: 360rpx;
  position: relative;
}

.activity-cover-large image {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.activity-status {
  position: absolute;
  top: 20rpx;
  right: 20rpx;
  padding: 8rpx 16rpx;
  font-size: var(--font-xs);
  background: var(--accent-color);
  color: var(--text-inverse);
  border-radius: var(--radius-sm);
}

.activity-status.ended {
  background: var(--text-tertiary);
}

.activity-info-large {
  padding: 24rpx;
}

.activity-title-large {
  font-size: var(--font-lg);
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 16rpx;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.activity-meta-large {
  display: flex;
  flex-wrap: wrap;
  margin-bottom: 16rpx;
}

.activity-meta-item {
  display: flex;
  align-items: center;
  font-size: var(--font-sm);
  color: var(--text-tertiary);
  margin-right: 24rpx;
  margin-bottom: 10rpx;
}

.activity-meta-item image {
  width: 28rpx;
  height: 28rpx;
  margin-right: 8rpx;
}

.activity-footer-large {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-top: 20rpx;
  border-top: 1rpx solid var(--border-color);
}

.activity-price-large {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--accent-color);
}

.activity-price-large text {
  font-size: var(--font-sm);
  font-weight: 400;
}

.activity-users {
  display: flex;
  align-items: center;
}

.activity-user-avatar {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  border: 2rpx solid var(--bg-white);
  margin-left: -16rpx;
}

.activity-user-avatar:first-child {
  margin-left: 0;
}

.activity-joined-count {
  font-size: var(--font-sm);
  color: var(--text-tertiary);
  margin-left: 12rpx;
}

/* 活动卡片 - 列表模式 */
.activity-item {
  display: flex;
  background: var(--bg-white);
  border-radius: var(--radius-lg);
  padding: 20rpx;
  margin-bottom: 16rpx;
  box-shadow: var(--shadow-sm);
}

.activity-cover-item {
  width: 180rpx;
  height: 180rpx;
  border-radius: var(--radius-md);
  overflow: hidden;
  flex-shrink: 0;
  margin-right: 20rpx;
  position: relative;
}

.activity-cover-item image {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.activity-info-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.activity-title-item {
  font-size: var(--font-base);
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 8rpx;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.activity-time-item {
  font-size: var(--font-xs);
  color: var(--text-tertiary);
  margin-bottom: 8rpx;
}

.activity-meta-item-row {
  display: flex;
  align-items: center;
}

.activity-price-item {
  font-size: var(--font-base);
  font-weight: 600;
  color: var(--accent-color);
}

/* 热门活动 */
.hot-section {
  margin-bottom: 30rpx;
}

.hot-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 30rpx;
}

.hot-title {
  font-size: var(--font-lg);
  font-weight: 600;
  color: var(--text-primary);
  display: flex;
  align-items: center;
}

.hot-title image {
  width: 32rpx;
  height: 32rpx;
  margin-right: 8rpx;
}

.hot-list {
  display: flex;
  overflow-x: auto;
  padding: 0 30rpx 20rpx;
  white-space: nowrap;
}

.hot-item {
  width: 280rpx;
  background: var(--bg-white);
  border-radius: var(--radius-lg);
  overflow: hidden;
  margin-right: 20rpx;
  flex-shrink: 0;
  box-shadow: var(--shadow-sm);
}

.hot-cover {
  width: 100%;
  height: 200rpx;
}

.hot-cover image {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.hot-info {
  padding: 16rpx;
}

.hot-name {
  font-size: var(--font-sm);
  font-weight: 500;
  color: var(--text-primary);
  margin-bottom: 8rpx;
  display: -webkit-box;
  -webkit-line-clamp: 1;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.hot-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.hot-price {
  font-size: var(--font-base);
  font-weight: 600;
  color: var(--accent-color);
}

.hot-count {
  font-size: var(--font-xs);
  color: var(--text-tertiary);
}

/* 创建活动按钮 */
.create-btn {
  position: fixed;
  right: 30rpx;
  bottom: 100rpx;
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #FF6B35 0%, #FF8C42 100%);
  box-shadow: var(--shadow-lg);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 90;
}

.create-btn image {
  width: 48rpx;
  height: 48rpx;
}

/* 筛选面板 */
.filter-panel {
  position: fixed;
  top: 0;
  right: 0;
  width: 600rpx;
  height: 100vh;
  background: var(--bg-white);
  z-index: 200;
  box-shadow: var(--shadow-xl);
}

.panel-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 30rpx;
  border-bottom: 1rpx solid var(--border-color);
}

.panel-title {
  font-size: var(--font-lg);
  font-weight: 600;
}

.panel-close {
  width: 48rpx;
  height: 48rpx;
}

.panel-content {
  padding: 30rpx;
}

.panel-section {
  margin-bottom: 30rpx;
}

.panel-section-title {
  font-size: var(--font-base);
  font-weight: 500;
  color: var(--text-primary);
  margin-bottom: 16rpx;
}

.panel-tags {
  display: flex;
  flex-wrap: wrap;
}

.panel-tag {
  padding: 12rpx 24rpx;
  font-size: var(--font-sm);
  background: var(--bg-gray);
  color: var(--text-secondary);
  border-radius: var(--radius-full);
  margin-right: 16rpx;
  margin-bottom: 16rpx;
}

.panel-tag.active {
  background: var(--primary-color);
  color: var(--text-inverse);
}

.panel-footer {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  padding: 20rpx 30rpx;
  background: var(--bg-white);
  border-top: 1rpx solid var(--border-color);
}

.panel-btn {
  flex: 1;
  height: 80rpx;
  border-radius: var(--radius-full);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--font-base);
}

.panel-btn-reset {
  background: var(--bg-gray);
  color: var(--text-secondary);
  margin-right: 20rpx;
}

.panel-btn-confirm {
  background: var(--primary-color);
  color: var(--text-inverse);
}

/* 活动详情页关联样式 */
.activity-detail-header {
  position: relative;
}

.detail-cover {
  width: 100%;
  height: 500rpx;
}

.detail-cover image {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.detail-info {
  background: var(--bg-white);
  border-radius: var(--radius-xl) var(--radius-xl) 0 0;
  margin-top: -40rpx;
  position: relative;
  padding: 40rpx 30rpx;
}

.detail-title {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--text-primary);
  margin-bottom: 20rpx;
}

.detail-stats {
  display: flex;
  justify-content: space-around;
  padding: 30rpx 0;
  border-top: 1rpx solid var(--border-color);
  border-bottom: 1rpx solid var(--border-color);
  margin: 20rpx 0;
}

.stat-item {
  text-align: center;
}

.stat-value {
  font-size: var(--font-xl);
  font-weight: 700;
  color: var(--primary-color);
}

.stat-label {
  font-size: var(--font-sm);
  color: var(--text-tertiary);
  margin-top: 8rpx;
}