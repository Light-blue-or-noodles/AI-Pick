/* pages/user-profile/user-profile.wxss */

.container {
  min-height: 100vh;
  background: #F5F5F5;
}

/* Loading */
.loading {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 60rpx 0;
  font-size: 28rpx;
  color: #999999;
}

/* 上部：用户信息区 */
.user-header {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  padding: 40rpx 30rpx 30rpx;
  position: relative;
}

.user-info {
  display: flex;
  align-items: flex-start;
  margin-bottom: 30rpx;
}

/* 头像：样式作用在 network-image 根节点，与组件内 image 的 100% 尺寸配合 */
.user-info network-image.user-avatar,
.user-avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255, 255, 255, 0.3);
  flex-shrink: 0;
  overflow: hidden;
  display: block;
  box-sizing: border-box;
}

.user-detail {
  margin-left: 24rpx;
  flex: 1;
  color: #ffffff;
}

.user-name {
  font-size: 40rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
  display: block;
}

.user-bio {
  font-size: 26rpx;
  opacity: 0.9;
  margin-bottom: 16rpx;
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.org-info {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.org-item {
  font-size: 24rpx;
  opacity: 0.85;
  background: rgba(255, 255, 255, 0.2);
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
}

/* 操作按钮 */
.action-bar {
  display: flex;
  gap: 20rpx;
  margin-bottom: 30rpx;
}

.btn-follow {
  flex: 1;
  background: #ffffff;
  border-radius: 40rpx;
  padding: 20rpx 0;
  text-align: center;
}

.btn-follow text {
  font-size: 30rpx;
  color: #667eea;
  font-weight: 500;
}

.btn-follow.following {
  background: rgba(255, 255, 255, 0.2);
}

.btn-follow.following text {
  color: #ffffff;
}

.btn-chat {
  flex: 1;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 40rpx;
  padding: 20rpx 0;
  text-align: center;
}

.btn-chat text {
  font-size: 30rpx;
  color: #ffffff;
  font-weight: 500;
}

/* 用户统计 */
.user-stats {
  display: flex;
  justify-content: space-around;
  background: rgba(255, 255, 255, 0.15);
  border-radius: 20rpx;
  padding: 24rpx 0;
  backdrop-filter: blur(10px);
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  color: #ffffff;
}

.stat-value {
  font-size: 36rpx;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.stat-label {
  font-size: 24rpx;
  opacity: 0.9;
}

.stat-divider {
  width: 2rpx;
  background: rgba(255, 255, 255, 0.3);
}

/* 下部：搭子列表 */
.partners-section {
  padding: 30rpx;
}

.section-title {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.section-title text {
  font-size: 32rpx;
  font-weight: 600;
  color: #333333;
}

.section-count {
  font-size: 26rpx;
  color: #999999;
  font-weight: normal;
}

/* 搭子卡片 */
.partner-card {
  background: #ffffff;
  border-radius: 20rpx;
  margin-bottom: 24rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
}

.partner-cover-wrap {
  position: relative;
  height: 280rpx;
}

/* 封面：network-image 根节点铺满容器，内部 image 已为 width/height 100% */
.partner-cover-wrap network-image.partner-cover,
.partner-cover {
  width: 100%;
  height: 100%;
  display: block;
}

.partner-status-tag {
  position: absolute;
  top: 20rpx;
  right: 20rpx;
  padding: 8rpx 20rpx;
  border-radius: 24rpx;
  font-size: 24rpx;
  color: #ffffff;
}

.partner-status-tag.recruiting {
  background: #52c41a;
}

.partner-status-tag.full {
  background: #faad14;
}

.partner-status-tag.ended {
  background: #999999;
}

.visibility-tag {
  position: absolute;
  top: 20rpx;
  left: 20rpx;
  padding: 8rpx 16rpx;
  border-radius: 24rpx;
  font-size: 22rpx;
  color: #ffffff;
  background: rgba(0, 0, 0, 0.5);
}

/* 公开可见性（绿色） */
.visibility-tag.public {
  background: rgba(82, 196, 26, 0.8);
}

.visibility-tag.public {
  background: rgba(82, 196, 26, 0.8);
}

.partner-body {
  padding: 24rpx;
}

.partner-header {
  margin-bottom: 16rpx;
}

.partner-category {
  font-size: 24rpx;
  color: #667eea;
  background: rgba(102, 126, 234, 0.1);
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
  display: inline-block;
}

.partner-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 12rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.partner-pref {
  font-size: 26rpx;
  color: #666666;
  margin-bottom: 16rpx;
}

.partner-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.tag {
  font-size: 24rpx;
  color: #999999;
  background: #F5F5F5;
  padding: 8rpx 16rpx;
  border-radius: 8rpx;
}

.partner-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.member-info {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.member-count {
  font-size: 26rpx;
  color: #666666;
}

.partner-time {
  font-size: 24rpx;
  color: #999999;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 40rpx;
}

.empty-state image {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 30rpx;
  opacity: 0.6;
}

.empty-state text {
  font-size: 28rpx;
  color: #999999;
}