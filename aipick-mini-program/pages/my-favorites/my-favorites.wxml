<!--pages/my-favorites/my-favorites-->
<view class="container">
  <!-- Header -->
  <view class="header">
    <text class="title">我的收藏</text>
    <text class="subtitle">收藏的活动</text>
  </view>

  <!-- Loading -->
  <view class="loading" wx:if="{{isLoading}}">
    <text>加载中...</text>
  </view>

  <!-- Activity Favorites List -->
  <view class="list" wx:if="{{!isLoading}}">
    <view 
      class="activity-card"
      wx:for="{{favoriteActivities}}"
      wx:key="id"
    >
      <view class="card-content" bindtap="onViewActivityDetail" data-id="{{item.id}}">
        <image class="activity-cover" src="{{item.cover}}" mode="aspectFill" />
        <view class="activity-info">
          <view class="activity-header">
            <text class="activity-title">🎯 {{item.title}}</text>
            <text class="activity-status">{{item.statusText}}</text>
          </view>
          <view class="activity-meta">
            <text class="meta-item">📅 {{item.startTime}}</text>
            <text class="meta-tag">🏷️ {{item.category}}</text>
          </view>
          <view class="activity-location" wx:if="{{item.location}}">
            <text class="location-text">📍 {{item.location}}</text>
          </view>
        </view>
      </view>
      <view class="card-actions">
        <view class="btn-cancel" catchtap="onCancelActivityFavorite" data-id="{{item.id}}">
          <text>取消收藏</text>
        </view>
      </view>
    </view>
    
    <view class="empty-state" wx:if="{{favoriteActivities.length === 0}}">
      <image src="/images/empty-activity.png" mode="aspectFit" />
      <text>暂无收藏的活动</text>
      <text class="empty-tip">去首页发现精彩活动吧</text>
    </view>
  </view>
</view>
