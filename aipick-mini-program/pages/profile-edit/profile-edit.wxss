/* pages/profile-edit/profile-edit.wxss */

.container {
  min-height: 100vh;
  background: #F5F5F5;
}

/* Header */
.header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 88rpx;
  padding: 0 24rpx;
  background: #ffffff;
  border-bottom: 1rpx solid #E5E5E5;
  position: sticky;
  top: 0;
  z-index: 10;
}

.back-btn {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.back-icon {
  font-size: 40rpx;
  color: #333333;
}

.header-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #1A1A1A;
}

.save-btn {
  padding: 12rpx 24rpx;
  color: #FF6B35;
  font-size: 30rpx;
}

/* Form */
.form {
  padding: 32rpx;
}

.form-item {
  margin-bottom: 40rpx;
}

.form-label {
  font-size: 30rpx;
  font-weight: 500;
  color: #1A1A1A;
  display: block;
  margin-bottom: 16rpx;
}

.form-label-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.form-label-row .form-label {
  margin-bottom: 0;
}

.form-count {
  font-size: 24rpx;
  color: #999999;
}

/* Avatar */
.avatar-item {
  display: flex;
  justify-content: center;
  padding: 20rpx 0;
}

.avatar-section {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.avatar {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  border: 4rpx solid #ffffff;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.1);
}

.avatar-tip {
  margin-top: 16rpx;
  font-size: 26rpx;
  color: #999999;
}

/* Form Input */
.form-input {
  background: #ffffff;
  border-radius: 12rpx;
  padding: 24rpx;
  font-size: 30rpx;
  color: #333333;
  border: 1rpx solid #E5E5E5;
}

.form-input::placeholder {
  color: #999999;
}

/* Gender Options */
.gender-options {
  display: flex;
  gap: 24rpx;
}

.gender-option {
  flex: 1;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #ffffff;
  border: 1rpx solid #E5E5E5;
  border-radius: 12rpx;
  font-size: 30rpx;
  color: #666666;
}

.gender-option.active {
  background: #FF6B35;
  border-color: #FF6B35;
  color: #ffffff;
}

/* Picker - 与输入框统一风格，右侧箭头 */
.picker-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #ffffff;
  border-radius: 12rpx;
  padding: 24rpx 24rpx 24rpx 28rpx;
  border: 1rpx solid #E5E5E5;
  min-height: 88rpx;
  box-sizing: border-box;
}

.picker-text {
  font-size: 30rpx;
  color: #999999;
}

.picker-text.has-value {
  color: #333333;
}

.picker-arrow {
  width: 28rpx;
  height: 28rpx;
  opacity: 0.5;
}

/* Textarea */
.form-textarea {
  background: #ffffff;
  border-radius: 12rpx;
  padding: 24rpx;
  font-size: 30rpx;
  color: #333333;
  border: 1rpx solid #E5E5E5;
  width: 100%;
  height: 160rpx;
  box-sizing: border-box;
}

.form-textarea::placeholder {
  color: #999999;
}

/* Tags */
.selected-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 20rpx;
  min-height: 60rpx;
}

.tag-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 20rpx;
  background: #FF6B35;
  border-radius: 32rpx;
  font-size: 26rpx;
  color: #ffffff;
}

.tag-remove {
  font-size: 32rpx;
}

.tag-tip {
  font-size: 26rpx;
  color: #999999;
  padding: 12rpx 0;
}

.available-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.available-tag {
  padding: 12rpx 24rpx;
  background: #ffffff;
  border: 1rpx solid #E5E5E5;
  border-radius: 32rpx;
  font-size: 26rpx;
  color: #666666;
}