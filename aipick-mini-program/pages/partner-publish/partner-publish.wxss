/* pages/partner-publish/partner-publish.wxss */

@import '../../styles/variables.wxss';

.container {
  min-height: 100vh;
  background: var(--bg-color);
}

/* Form */
.form {
  padding: 32rpx;
}

.form-item {
  margin-bottom: 40rpx;
}

.form-label-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.form-label {
  font-size: 30rpx;
  font-weight: 500;
  color: #1A1A1A;
}

.form-count {
  font-size: 24rpx;
  color: #999999;
}

.form-input {
  background: #ffffff;
  border-radius: 12rpx;
  padding: 24rpx;
  font-size: 30rpx;
  color: #333333;
  border: 1rpx solid #E5E5E5;
}

.form-input::placeholder {
  color: #999999;
}

.form-hint {
  display: block;
  font-size: 24rpx;
  color: #999999;
  margin-bottom: 16rpx;
}

.form-link {
  font-size: 26rpx;
  color: var(--primary-color);
}

.datetime-row {
  display: flex;
  gap: 20rpx;
}

.picker-box {
  flex: 1;
  padding: 24rpx;
  background: #ffffff;
  border-radius: 12rpx;
  border: 1rpx solid #e5e5e5;
  font-size: 28rpx;
  color: #333333;
  text-align: center;
}

.location-row {
  margin-top: 8rpx;
}

.location-pick {
  padding: 24rpx;
  background: #ffffff;
  border-radius: 12rpx;
  border: 1rpx solid #e5e5e5;
  font-size: 28rpx;
  color: #333333;
  line-height: 1.45;
}

.location-placeholder {
  color: #999999;
}

/* 搭子偏好标签（多选） */
.pref-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.pref-tag {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 14rpx 22rpx;
  background: #ffffff;
  border: 1rpx solid #E5E5E5;
  border-radius: 32rpx;
  font-size: 26rpx;
  color: #555555;
  box-sizing: border-box;
}

.pref-tag.active {
  background: var(--primary-color);
  border-color: var(--primary-color);
  color: #ffffff;
}

.pref-tag-ico {
  font-size: 28rpx;
  line-height: 1;
}

.pref-tag-txt {
  font-size: 26rpx;
}

/* Type Tags */
.type-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.type-tag {
  padding: 16rpx 32rpx;
  background: #ffffff;
  border: 1rpx solid #E5E5E5;
  border-radius: 32rpx;
  font-size: 28rpx;
  color: #666666;
}

.type-tag.active {
  background: var(--primary-color);
  border-color: var(--primary-color);
  color: #ffffff;
}

/* Textarea */
.form-textarea {
  background: #ffffff;
  border-radius: 12rpx;
  padding: 24rpx;
  font-size: 30rpx;
  color: #333333;
  border: 1rpx solid #E5E5E5;
  width: 100%;
  height: 200rpx;
  box-sizing: border-box;
}

.form-textarea::placeholder {
  color: #999999;
}

/* Counter */
.counter {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 40rpx;
  padding: 20rpx 0;
}

.counter-btn {
  width: 80rpx;
  height: 80rpx;
  background: var(--primary-color);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  color: #ffffff;
}

.counter-btn.disabled {
  background: #E5E5E5;
  color: #999999;
}

.counter-value {
  display: flex;
  align-items: baseline;
  min-width: 120rpx;
  justify-content: center;
}

.count-number {
  font-size: 48rpx;
  font-weight: 600;
  color: #1A1A1A;
}

.count-unit {
  font-size: 28rpx;
  color: #666666;
  margin-left: 8rpx;
}

/* Scope Tags */
.scope-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.scope-tag {
  padding: 16rpx 32rpx;
  background: #ffffff;
  border: 1rpx solid #E5E5E5;
  border-radius: 32rpx;
  font-size: 28rpx;
  color: #666666;
}

.scope-tag.active {
  background: var(--primary-color);
  border-color: var(--primary-color);
  color: #ffffff;
}

.scope-tag.disabled {
  opacity: 0.45;
}

.scope-hint {
  display: block;
  margin-top: 12rpx;
  font-size: 24rpx;
  color: var(--text-tertiary);
  line-height: 1.45;
}

/* Divider */
.divider {
  height: 1rpx;
  background: #E5E5E5;
  margin: 40rpx 0;
}

/* AI Button */
.ai-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  padding: 24rpx;
  background: linear-gradient(135deg, #667EEA 0%, #764BA2 100%);
  border-radius: 48rpx;
  margin-bottom: 32rpx;
}

.ai-icon {
  font-size: 36rpx;
}

.ai-text {
  font-size: 30rpx;
  color: #ffffff;
  font-weight: 500;
}

/* Submit Button */
.submit-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 96rpx;
  background: var(--primary-color);
  border-radius: 48rpx;
  font-size: 34rpx;
  color: #ffffff;
  font-weight: 500;
}

/* 封面单张 */
.cover-row {
  display: flex;
  flex-wrap: wrap;
  align-items: flex-start;
  gap: 20rpx;
}

.cover-preview {
  position: relative;
  width: 100%;
  max-width: 400rpx;
  height: 220rpx;
  border-radius: 12rpx;
  overflow: hidden;
  background: #f0f0f0;
  border: 1rpx solid #E5E5E5;
}

.cover-img {
  width: 100%;
  height: 100%;
  display: block;
}

.cover-tip {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 12rpx;
  font-size: 22rpx;
  color: #fff;
  text-align: center;
  background: linear-gradient(transparent, rgba(0, 0, 0, 0.55));
}

.cover-placeholder {
  width: 100%;
  max-width: 400rpx;
  height: 220rpx;
  border-radius: 12rpx;
  border: 2rpx dashed #ccc;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: #999;
  background: #fafafa;
}

.cover-clear {
  align-self: center;
  padding: 12rpx 24rpx;
  font-size: 26rpx;
  color: var(--text-tertiary);
}