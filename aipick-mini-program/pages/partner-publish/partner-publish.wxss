/* pages/partner-publish/partner-publish.wxss */

.container {
  min-height: 100vh;
  background: #F5F5F5;
}

/* Header */
.header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 88rpx;
  padding: 0 24rpx;
  background: #ffffff;
  border-bottom: 1rpx solid #E5E5E5;
  position: sticky;
  top: 0;
  z-index: 10;
}

.back-btn {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.back-icon {
  font-size: 40rpx;
  color: #333333;
}

.header-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #1A1A1A;
}

/* Form */
.form {
  padding: 32rpx;
}

.form-item {
  margin-bottom: 40rpx;
}

.form-label-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.form-label {
  font-size: 30rpx;
  font-weight: 500;
  color: #1A1A1A;
}

.form-count {
  font-size: 24rpx;
  color: #999999;
}

.form-input {
  background: #ffffff;
  border-radius: 12rpx;
  padding: 24rpx;
  font-size: 30rpx;
  color: #333333;
  border: 1rpx solid #E5E5E5;
}

.form-input::placeholder {
  color: #999999;
}

/* Type Tags */
.type-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.type-tag {
  padding: 16rpx 32rpx;
  background: #ffffff;
  border: 1rpx solid #E5E5E5;
  border-radius: 32rpx;
  font-size: 28rpx;
  color: #666666;
}

.type-tag.active {
  background: #FF6B35;
  border-color: #FF6B35;
  color: #ffffff;
}

/* Textarea */
.form-textarea {
  background: #ffffff;
  border-radius: 12rpx;
  padding: 24rpx;
  font-size: 30rpx;
  color: #333333;
  border: 1rpx solid #E5E5E5;
  width: 100%;
  height: 200rpx;
  box-sizing: border-box;
}

.form-textarea::placeholder {
  color: #999999;
}

/* Counter */
.counter {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 40rpx;
  padding: 20rpx 0;
}

.counter-btn {
  width: 80rpx;
  height: 80rpx;
  background: #FF6B35;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  color: #ffffff;
}

.counter-btn.disabled {
  background: #E5E5E5;
  color: #999999;
}

.counter-value {
  display: flex;
  align-items: baseline;
  min-width: 120rpx;
  justify-content: center;
}

.count-number {
  font-size: 48rpx;
  font-weight: 600;
  color: #1A1A1A;
}

.count-unit {
  font-size: 28rpx;
  color: #666666;
  margin-left: 8rpx;
}

/* Scope Tags */
.scope-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.scope-tag {
  padding: 16rpx 32rpx;
  background: #ffffff;
  border: 1rpx solid #E5E5E5;
  border-radius: 32rpx;
  font-size: 28rpx;
  color: #666666;
}

.scope-tag.active {
  background: #FF6B35;
  border-color: #FF6B35;
  color: #ffffff;
}

/* Divider */
.divider {
  height: 1rpx;
  background: #E5E5E5;
  margin: 40rpx 0;
}

/* AI Button */
.ai-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  padding: 24rpx;
  background: linear-gradient(135deg, #667EEA 0%, #764BA2 100%);
  border-radius: 48rpx;
  margin-bottom: 32rpx;
}

.ai-icon {
  font-size: 36rpx;
}

.ai-text {
  font-size: 30rpx;
  color: #ffffff;
  font-weight: 500;
}

/* Submit Button */
.submit-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 96rpx;
  background: #FF6B35;
  border-radius: 48rpx;
  font-size: 34rpx;
  color: #ffffff;
  font-weight: 500;
}