/* pages/account-security/account-security.wxss */

.container {
  min-height: 100vh;
  background: #F5F5F5;
  padding-bottom: 40rpx;
}

/* Section */
.section {
  margin-top: 20rpx;
  background: #ffffff;
}

.section-title {
  font-size: 26rpx;
  color: #999999;
  padding: 20rpx 32rpx;
  background: #FAFAFA;
}

/* Security Item */
.security-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 100rpx;
  padding: 0 32rpx;
  border-bottom: 1rpx solid #F5F5F5;
  box-sizing: border-box;
}

.security-item:last-child {
  border-bottom: none;
}

.item-label {
  font-size: 30rpx;
  color: #333333;
}

.item-right {
  display: flex;
  align-items: center;
}

.item-value {
  font-size: 28rpx;
  color: #999999;
  margin-right: 12rpx;
}

.item-value.bound {
  color: #2ED573;
}

.arrow-icon {
  width: 24rpx;
  height: 24rpx;
  flex-shrink: 0;
}

/* Info Item */
.info-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 80rpx;
  padding: 0 32rpx;
  border-bottom: 1rpx solid #F5F5F5;
}

.info-item:last-child {
  border-bottom: none;
}

.info-label {
  font-size: 28rpx;
  color: #666666;
}

.info-value {
  font-size: 28rpx;
  color: #999999;
}

/* Danger Section */
.section.danger {
  margin-top: 40rpx;
}

.danger-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 100rpx;
  padding: 0 32rpx;
}

.danger-label {
  font-size: 30rpx;
  color: #FF3B30;
}

/* Tips */
.tips {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx 32rpx;
}

.tips-text {
  font-size: 26rpx;
  color: #999999;
}
