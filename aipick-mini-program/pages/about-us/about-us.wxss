/* pages/about-us/about-us.wxss */

.container {
  min-height: 100vh;
  background: #F5F5F5;
  padding-bottom: 40rpx;
}

/* App Info */
.app-info {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 40rpx;
  background: #ffffff;
}

.app-logo {
  width: 160rpx;
  height: 160rpx;
  border-radius: 32rpx;
  margin-bottom: 24rpx;
}

.app-name {
  font-size: 40rpx;
  color: #333333;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.app-slogan {
  font-size: 28rpx;
  color: #666666;
  margin-bottom: 16rpx;
}

.app-version {
  font-size: 24rpx;
  color: #999999;
}

/* Section */
.section {
  margin-top: 20rpx;
  background: #ffffff;
}

.section-title {
  font-size: 26rpx;
  color: #999999;
  padding: 20rpx 32rpx;
  background: #FAFAFA;
}

/* Features */
.feature-list {
  padding: 20rpx 32rpx;
}

.feature-item {
  display: flex;
  align-items: flex-start;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #F5F5F5;
}

.feature-item:last-child {
  border-bottom: none;
}

.feature-icon {
  font-size: 48rpx;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.feature-content {
  flex: 1;
}

.feature-title {
  font-size: 30rpx;
  color: #333333;
  font-weight: 500;
  margin-bottom: 8rpx;
}

.feature-desc {
  font-size: 26rpx;
  color: #999999;
}

/* Contact & Legal */
.contact-list,
.legal-list {
  padding: 0 32rpx;
}

.contact-item,
.legal-item,
.update-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 100rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #F5F5F5;
}

.contact-item:last-child,
.legal-item:last-child {
  border-bottom: none;
}

.contact-label,
.legal-label,
.update-label {
  font-size: 30rpx;
  color: #333333;
}

.contact-right,
.update-right {
  display: flex;
  align-items: center;
}

.contact-value,
.update-version {
  font-size: 28rpx;
  color: #999999;
  margin-right: 12rpx;
}

.arrow-icon {
  width: 24rpx;
  height: 24rpx;
  flex-shrink: 0;
}

/* Copyright */
.copyright {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 40rpx;
}

.copyright text {
  font-size: 24rpx;
  color: #CCCCCC;
  margin-bottom: 8rpx;
}
