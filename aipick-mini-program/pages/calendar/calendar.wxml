<!--pages/calendar/calendar.wxml - 标题使用导航栏，返回使用微信默认 -->
<view class="container">
  <!-- 月份切换 -->
  <view class="month-switch">
    <view class="switch-btn" bindtap="prevMonth">
      <text>◀</text>
    </view>
    <view class="current-month">
      <text>{{currentYear}}年{{currentMonth}}月</text>
    </view>
    <view class="switch-btn" bindtap="nextMonth">
      <text>▶</text>
    </view>
  </view>

  <!-- 日历 -->
  <view class="calendar">
    <!-- 星期标题 -->
    <view class="week-title">
      <view class="week-item">一</view>
      <view class="week-item">二</view>
      <view class="week-item">三</view>
      <view class="week-item">四</view>
      <view class="week-item">五</view>
      <view class="week-item weekend">六</view>
      <view class="week-item weekend">日</view>
    </view>

    <!-- 日期网格 -->
    <view class="date-grid">
      <block wx:for="{{calendarDays}}" wx:key="day">
        <view class="date-item {{item.isToday ? 'today' : ''}} {{item.isSelected ? 'selected' : ''}} {{item.hasActivity ? 'has-activity' : ''}}" 
              bindtap="selectDate" 
              data-date="{{item.date}}"
              wx:if="{{item.day}}">
          <text class="day-number">{{item.day}}</text>
          <view class="activity-dot" wx:if="{{item.hasActivity}}"></view>
        </view>
        <view class="date-item empty" wx:else></view>
      </block>
    </view>
  </view>

  <!-- 当日活动列表 -->
  <view class="activity-list">
    <view class="list-header">
      <text class="list-title">{{selectedDateStr}} 活动</text>
      <text class="activity-count">({{selectedDateActivities.length}}个)</text>
    </view>

    <scroll-view class="list-content" scroll-y wx:if="{{selectedDateActivities.length > 0}}">
      <block wx:for="{{selectedDateActivities}}" wx:key="id">
        <view class="activity-card" bindtap="goToActivity" data-id="{{item.id}}">
          <view class="activity-cover-wrap">
            <network-image class="activity-cover" customClass="activity-cover" url="{{item.cover}}" defaultSrc="/images/empty-activity.png" mode="aspectFill" />
          </view>
          <view class="activity-info">
            <view class="activity-name">{{item.name}}</view>
            <view class="activity-meta">
              <text class="meta-time">🕐 {{item.time}}</text>
              <text class="meta-location">📍 {{item.location}}</text>
            </view>
            <view class="activity-status">
              <text class="status-tag {{item.status}}">{{item.statusText}}</text>
              <text class="people-count">{{item.currentPeople}}/{{item.totalPeople}}人</text>
            </view>
          </view>
        </view>
      </block>
    </scroll-view>

    <view class="empty-tip" wx:else>
      <text>当天暂无活动</text>
    </view>
  </view>
</view>