/* pages/calendar/calendar.wxss */
@import '../../styles/variables.wxss';

.container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background-color: var(--bg-color);
}

/* 月份切换（标题已在导航栏展示） */
.month-switch {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx var(--page-horizontal, 30rpx);
  background-color: var(--bg-white);
}

.switch-btn {
  padding: 8px 16px;
  font-size: 16px;
  color: var(--primary-color);
}

.current-month {
  font-size: 18px;
  font-weight: 500;
  color: #333;
}

/* 日历 */
.calendar {
  background-color: #fff;
  padding: 0 10px 15px;
}

.week-title {
  display: flex;
  margin-bottom: 10px;
}

.week-item {
  flex: 1;
  text-align: center;
  font-size: 13px;
  color: #999;
  padding: 8px 0;
}

.week-item.weekend {
  color: var(--primary-color);
}

.date-grid {
  display: flex;
  flex-wrap: wrap;
}

.date-item {
  width: 14.28%;
  aspect-ratio: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  position: relative;
}

.date-item.empty {
  visibility: hidden;
}

.day-number {
  font-size: 15px;
  color: #333;
}

.date-item.today .day-number {
  color: var(--primary-color);
  font-weight: 500;
}

.date-item.selected {
  background-color: var(--primary-color);
  border-radius: 50%;
}

.date-item.selected .day-number {
  color: #fff;
}

.activity-dot {
  width: 5px;
  height: 5px;
  background-color: var(--primary-color);
  border-radius: 50%;
  position: absolute;
  bottom: 8px;
}

.date-item.selected .activity-dot {
  background-color: #fff;
}

/* 活动列表 */
.activity-list {
  flex: 1;
  display: flex;
  flex-direction: column;
  margin-top: 10px;
  background-color: #fff;
  padding: 15px;
}

.list-header {
  display: flex;
  align-items: center;
  margin-bottom: 15px;
}

.list-title {
  font-size: 16px;
  font-weight: 500;
  color: #333;
}

.activity-count {
  font-size: 13px;
  color: #999;
  margin-left: 8px;
}

.list-content {
  flex: 1;
}

.activity-card {
  display: flex;
  padding: 12px;
  background-color: #f9f9f9;
  border-radius: 12px;
  margin-bottom: 12px;
}

.activity-card:active {
  background-color: #f0f0f0;
}

.activity-cover-wrap {
  width: 80px;
  height: 80px;
  border-radius: 8px;
  margin-right: 12px;
  overflow: hidden;
  flex-shrink: 0;
}

.activity-cover {
  width: 100%;
  height: 100%;
}

.activity-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.activity-name {
  font-size: 15px;
  font-weight: 500;
  color: #333;
}

.activity-meta {
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.meta-time, .meta-location {
  font-size: 12px;
  color: #999;
}

.activity-status {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.status-tag {
  padding: 3px 8px;
  font-size: 11px;
  border-radius: 10px;
}

.status-tag.recruiting {
  background-color: #e8f5e9;
  color: #4caf50;
}

.status-tag.full {
  background-color: #ffebee;
  color: #f44336;
}

.people-count {
  font-size: 12px;
  color: #999;
}

.empty-tip {
  text-align: center;
  padding: 40px 0;
  color: #999;
  font-size: 14px;
}