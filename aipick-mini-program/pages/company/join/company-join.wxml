<!--pages/company/join/company-join.wxml-->
<view class="page">
  <view class="content">
    <view class="card form-card" wx:if="{{!hasJoined}}">
      <text class="field-label">公司名称</text>
      <input
        class="field-input"
        type="text"
        placeholder="请输入公司全称"
        placeholder-class="ph"
        value="{{companyName}}"
        bindinput="onCompanyInput"
        maxlength="50"
      />
      <button class="btn-primary" bindtap="onSubmit" disabled="{{submitting}}" loading="{{submitting}}">
        {{submitting ? '提交中...' : '确认加入'}}
      </button>
    </view>

    <view class="card status-card" wx:else>
      <view class="status-badge">✓</view>
      <text class="status-heading">已加入公司</text>
      <text class="status-name">{{userCompany}}</text>
      <button class="btn-outline" bindtap="onChangeCompany">更换公司</button>
    </view>

    <view class="card tips-card">
      <text class="tips-heading">温馨提示</text>
      <view class="tips-line"><text class="tips-num">1</text><text class="tips-text">公司名称请填写全称，确保准确</text></view>
      <view class="tips-line"><text class="tips-num">2</text><text class="tips-text">加入后可在个人中心查看</text></view>
      <view class="tips-line"><text class="tips-num">3</text><text class="tips-text">如需更换公司可重新提交</text></view>
    </view>
  </view>
</view>
