<!--pages/activity/activity.wxml-->
<view class="container">
  <!-- 顶部工具栏：活动日历 + 搜索 -->
  <view class="top-bar">
    <view class="top-bar-btn calendar-btn" bindtap="goToCalendar">
      <view class="top-bar-calendar-icon">
        <view class="top-bar-calendar-top"></view>
        <view class="top-bar-calendar-body"></view>
        <view class="top-bar-calendar-dot"></view>
      </view>
      <text class="top-bar-btn-text">活动日历</text>
    </view>
    <view class="search-box">
      <input
        class="search-input"
        type="text"
        placeholder="搜索活动..."
        value="{{searchKeyword}}"
        confirm-type="search"
        bindinput="onSearchInput"
        bindconfirm="onSearchConfirm"
      />
      <view class="search-btn" bindtap="onSearchTap">
        <text class="search-btn-text">搜索</text>
      </view>
    </view>
    <!-- 筛选入口按钮，保留原有筛选功能 -->
    <view class="top-bar-btn filter-btn" bindtap="goToFilter">
      <text class="top-bar-btn-text">筛选</text>
    </view>
  </view>

  <!-- 活动列表：和首页一样用整页滚动，避免底部白块遮挡 -->
  <view class="activity-list" wx:if="{{!isLoading}}">
    <block wx:for="{{activities}}" wx:key="id">
      <view class="activity-card" bindtap="goToDetail" data-id="{{item.id}}">
        <network-image class="activity-cover" customClass="activity-cover" url="{{item.cover}}" defaultSrc="/images/empty-activity.png" mode="aspectFill" />
        <view class="activity-badge" wx:if="{{item.isHot}}">热门</view>
        <!-- 活动状态标签 -->
        <view class="activity-status {{item.status}}">
          {{item.status === 'recruiting' ? '招募中' : (item.status === 'full' ? '已满' : '已结束')}}
        </view>
        <view class="activity-content">
          <view class="activity-title">{{item.title}}</view>
          <view class="activity-tags">
            <text class="tag">{{item.category}}</text>
          </view>
          <view class="activity-info">
            <view class="info-item">
              <image src="/images/time.png" mode="aspectFit" />
              <text>{{item.time}}</text>
            </view>
            <view class="info-item">
              <image src="/images/location.png" mode="aspectFit" />
              <text>{{item.location}}</text>
            </view>
          </view>
          <view class="activity-footer">
            <view class="author-info">
              <image class="author-avatar" src="{{item.author.avatar || '/images/default-avatar.png'}}" mode="aspectFill" />
              <text class="author-name">{{item.author.name}}</text>
            </view>
            <view class="participant-info">
              <view class="progress-bar">
                <view class="progress" style="width: {{item.progressPercent || 0}}%"></view>
              </view>
              <text class="participant-count">{{item.participantLabel}}</text>
            </view>
          </view>
        </view>
        <view class="activity-action">
          <view class="join-btn {{item.status === 'full' || item.status === 'ended' || item.hasRegistered ? 'disabled' : ''}}" 
                catchtap="joinActivity" 
                data-id="{{item.id}}">
            {{item.hasRegistered ? '已报名' : (item.status === 'full' ? '已满' : (item.status === 'ended' ? '已结束' : '立即报名'))}}
          </view>
        </view>
      </view>
    </block>

    <view class="empty-state" wx:if="{{activities.length === 0}}">
      <image src="/images/empty-activity.png" mode="aspectFit" />
      <text>暂无活动</text>
    </view>
  </view>

  <!-- 加载中 -->
  <view class="loading" wx:else>
    <text>加载中...</text>
  </view>

  <!-- 发布按钮：加号图标（跳转到创建活动页） -->
  <view class="publish-btn" bindtap="goToCreate">
    <text class="publish-btn-icon">+</text>
  </view>
</view>