/* pages/activity/activity.wxss - 活动页样式 */

@import '../../styles/variables.wxss';
@import '../../styles/common.wxss';
/* 不引入 circle.wxss，避免与当前页 .activity-card / .activity-status 冲突 */

/* 本页容器：和首页一样底部留白，整页滚动时最后一条不被导航栏挡 */
.container {
  padding-bottom: var(--tab-bar-padding);
}

/* 顶部工具栏：统一高度、留出安全区、视觉统一 */
.top-bar {
  display: flex;
  align-items: center;
  padding: var(--spacing-sm) var(--page-horizontal);
  padding-top: calc(var(--spacing-sm) + env(safe-area-inset-top));
  background: var(--bg-white);
  border-bottom: 1rpx solid var(--border-light);
  box-sizing: border-box;
  gap: 16rpx;
}

.search-box {
  flex: 1;
  min-width: 0;
  height: 72rpx;
  display: flex;
  align-items: center;
  padding: 0 12rpx 0 20rpx;
  background: var(--bg-gray);
  border-radius: var(--radius-full);
  box-sizing: border-box;
}

.search-input {
  flex: 1;
  min-width: 0;
  font-size: var(--font-base);
  color: var(--text-primary);
}

.search-input::placeholder {
  color: var(--text-tertiary);
}

.search-btn {
  margin-left: 16rpx;
  padding: 12rpx 24rpx;
  border-radius: var(--radius-full);
  background: var(--primary-color);
  display: flex;
  align-items: center;
  justify-content: center;
}

.search-btn-text {
  font-size: var(--font-sm);
  color: #fff;
}

.top-bar-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  height: 64rpx;
  padding: 0 20rpx;
  border-radius: 36rpx;
  box-sizing: border-box;
}

.top-bar-btn-icon {
  font-size: 32rpx;
  line-height: 1;
}

.top-bar-btn-text {
  font-size: var(--font-sm);
  line-height: 1;
}

/* 活动页顶部“活动日历”图标：小网格日历 */
.top-bar-calendar-icon {
  position: relative;
  width: 32rpx;
  height: 32rpx;
}

.top-bar-calendar-top {
  position: absolute;
  top: 3rpx;
  left: 4rpx;
  right: 4rpx;
  height: 6rpx;
  background: #5FB3A8;
  border-radius: 6rpx 6rpx 0 0;
}

.top-bar-calendar-body {
  position: absolute;
  top: 9rpx;
  left: 4rpx;
  right: 4rpx;
  bottom: 4rpx;
  background: #ffffff;
  border-radius: 0 0 6rpx 6rpx;
  border: 2rpx solid #5FB3A8;
  border-top: none;
  box-sizing: border-box;
}

.top-bar-calendar-dot {
  position: absolute;
  top: 13rpx;
  left: 7rpx;
  width: 4rpx;
  height: 4rpx;
  border-radius: 2rpx;
  background: #5FB3A8;
  box-shadow: 8rpx 0 0 #5FB3A8, 16rpx 0 0 #5FB3A8, 0 8rpx 0 #5FB3A8, 8rpx 8rpx 0 #5FB3A8, 16rpx 8rpx 0 #5FB3A8;
}

.calendar-btn {
  background: var(--bg-gray);
  color: var(--text-secondary);
}

/* 活动列表：和首页一致，整页滚动，无固定高度；底部留白仅由 .container 提供，不重复 */
.activity-list {
  padding: var(--page-horizontal);
  box-sizing: border-box;
}

.activity-card {
  background: var(--bg-white);
  border-radius: var(--radius-lg);
  overflow: hidden;
  margin-bottom: var(--card-gap);
  box-shadow: var(--shadow-sm);
  position: relative;
  transition: opacity 0.2s ease;
}

.activity-card:active {
  opacity: 0.98;
}

/* 活动封面：方形区域展示（圆角矩形，非圆形） */
.activity-cover {
  width: 100%;
  height: 260rpx;
  background: var(--bg-gray);
  display: block;
  border-radius: var(--radius-lg) var(--radius-lg) 0 0;
}

.activity-badge {
  position: absolute;
  top: 20rpx;
  left: 20rpx;
  padding: 8rpx 20rpx;
  background: var(--primary-color);
  color: #fff;
  font-size: var(--font-xs);
  border-radius: var(--radius-sm);
}

/* 活动状态标签：限制在卡片内，避免与底部按钮重叠 */
.activity-card .activity-status {
  position: absolute;
  top: 20rpx;
  right: 20rpx;
  padding: 8rpx 20rpx;
  font-size: var(--font-xs);
  border-radius: var(--radius-full);
  z-index: 2;
}

.activity-card .activity-status.recruiting {
  background: rgba(82, 196, 26, 0.95);
  color: #fff;
}

.activity-card .activity-status.full {
  background: rgba(255, 77, 79, 0.95);
  color: #fff;
}

.activity-card .activity-status.ended {
  background: rgba(0, 0, 0, 0.5);
  color: #fff;
}

.activity-content {
  padding: var(--card-inner);
}

.activity-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 12rpx;
  line-height: var(--line-normal);
}

.activity-tags {
  display: flex;
  margin-bottom: var(--spacing-sm);
}

/* 活动类型标签：主色底+白字，提升可读性 */
.activity-card .tag {
  display: inline-block;
  padding: 8rpx 20rpx;
  font-size: var(--font-sm);
  font-weight: 500;
  border-radius: var(--radius-sm);
  background: var(--primary-color);
  color: #fff;
}

.activity-info {
  margin-bottom: 16rpx;
}

.info-item {
  display: flex;
  align-items: center;
  margin-bottom: 10rpx;
}

.info-item image {
  width: 28rpx;
  height: 28rpx;
  margin-right: 10rpx;
}

.info-item text {
  font-size: var(--font-sm);
  color: var(--text-secondary);
}

.activity-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 20rpx;
  border-top: 1rpx solid var(--border-color);
}

.author-info {
  display: flex;
  align-items: center;
}

.author-avatar {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  margin-right: 12rpx;
}

.author-name {
  font-size: var(--font-sm);
  color: var(--text-secondary);
}

.participant-info {
  display: flex;
  align-items: center;
  flex: 1;
  min-width: 0;
}

.progress-bar {
  width: 160rpx;
  min-width: 160rpx;
  height: 12rpx;
  background: var(--border-color);
  border-radius: 6rpx;
  margin-right: 16rpx;
  overflow: hidden;
}

.progress {
  height: 100%;
  min-width: 8rpx;
  background: linear-gradient(90deg, var(--primary-color) 0%, var(--primary-light) 100%);
  border-radius: 6rpx;
}

.participant-count {
  font-size: var(--font-xs);
  color: var(--text-tertiary);
}

.activity-action {
  padding: 0 var(--card-inner) var(--card-inner);
  box-sizing: border-box;
}

.join-btn {
  display: block;
  width: 100%;
  box-sizing: border-box;
  padding: 20rpx 24rpx;
  background: linear-gradient(135deg, var(--primary-color) 0%, var(--primary-light) 100%);
  color: #fff;
  font-size: var(--font-base);
  text-align: center;
  border-radius: var(--radius-full);
  border: none;
}

.join-btn.disabled {
  background: var(--text-disabled);
}

/* 发布按钮：方案 B 精致小胶囊，与搭子页统一 */
.publish-btn {
  position: fixed;
  right: 32rpx;
  bottom: calc(178rpx + env(safe-area-inset-bottom, 0px));
  width: 62rpx;
  height: 62rpx;
  background: rgba(255, 255, 255, 0.96);
  border: 2rpx solid rgba(255, 255, 255, 0.9);
  border-radius: 9999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 3rpx 12rpx rgba(0, 0, 0, 0.10);
  backdrop-filter: blur(12rpx);
  z-index: 100;
}

.publish-btn-icon {
  font-size: 34rpx;
  font-weight: 500;
  color: #FF6B35;
  line-height: 1;
}

/* 弹窗 */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: var(--bg-overlay);
  z-index: 100;
}

.modal-content {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: var(--bg-white);
  border-radius: var(--radius-xl) var(--radius-xl) 0 0;
  padding: var(--spacing-md);
  padding-bottom: calc(var(--spacing-md) + env(safe-area-inset-bottom));
  z-index: 101;
  max-height: 80vh;
  overflow-y: auto;
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 30rpx;
}

.modal-title {
  font-size: var(--font-lg);
  font-weight: 600;
  color: var(--text-primary);
}

.modal-close {
  width: 40rpx;
  height: 40rpx;
}

.form-item {
  margin-bottom: 24rpx;
}

.form-label {
  display: block;
  font-size: var(--font-base);
  color: var(--text-secondary);
  margin-bottom: 12rpx;
}

.form-input,
.picker-value {
  width: 100%;
  padding: 20rpx 24rpx;
  background: var(--bg-gray);
  border-radius: var(--radius-md);
  font-size: var(--font-base);
  box-sizing: border-box;
}

.form-textarea {
  width: 100%;
  padding: 20rpx 24rpx;
  background: var(--bg-gray);
  border-radius: var(--radius-md);
  font-size: var(--font-base);
  min-height: 150rpx;
  box-sizing: border-box;
}

.submit-btn {
  width: 100%;
  padding: 24rpx;
  background: var(--primary-color);
  color: #fff;
  font-size: var(--font-lg);
  text-align: center;
  border-radius: var(--radius-full);
  margin-top: 20rpx;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: var(--spacing-xl) 0;
}

.empty-state image {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 20rpx;
  opacity: 0.5;
}

.empty-state text {
  color: var(--text-tertiary);
  font-size: var(--font-base);
}

.loading {
  display: flex;
  justify-content: center;
  padding: var(--spacing-lg);
  color: var(--text-tertiary);
  font-size: var(--font-base);
}