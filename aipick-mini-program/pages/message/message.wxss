/* pages/message/message.wxss - 消息页样式 */

@import '../../styles/variables.wxss';
@import '../../styles/common.wxss';
@import '../../styles/message.wxss';

/* 消息页：底部留出 Tab 栏高度 */
.container {
  padding-bottom: var(--tab-bar-padding);
  box-sizing: border-box;
}

.message-list {
  height: 100vh;
  background: var(--bg-color);
  padding-bottom: var(--tab-bar-padding);
  box-sizing: border-box;
}

.message-item {
  display: flex;
  align-items: center;
  padding: 24rpx 30rpx;
  background: var(--bg-white);
  margin-bottom: 1rpx;
}

.message-item:active {
  background: var(--bg-gray);
}

.message-item.unread {
  background: rgba(74, 144, 217, 0.03);
}

.message-avatar {
  position: relative;
  margin-right: 20rpx;
}

.message-avatar image {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
}

.online-status {
  position: absolute;
  bottom: 4rpx;
  right: 4rpx;
  width: 20rpx;
  height: 20rpx;
  background: var(--success-color);
  border: 4rpx solid var(--bg-white);
  border-radius: 50%;
}

.message-content {
  flex: 1;
  min-width: 0;
}

.message-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 10rpx;
}

.message-name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.message-time {
  font-size: var(--font-sm);
  color: var(--text-tertiary);
}

.message-body {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.message-text {
  font-size: var(--font-base);
  color: var(--text-secondary);
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  margin-right: 16rpx;
}

.unread-badge {
  min-width: 36rpx;
  height: 36rpx;
  padding: 0 10rpx;
  background: var(--error-color);
  color: #fff;
  font-size: var(--font-xs);
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 200rpx 0;
}

.empty-state image {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 20rpx;
  opacity: 0.5;
}

.empty-state text {
  color: var(--text-tertiary);
  font-size: var(--font-base);
}

.loading {
  display: flex;
  justify-content: center;
  padding: var(--spacing-lg);
  color: var(--text-tertiary);
  font-size: var(--font-base);
}