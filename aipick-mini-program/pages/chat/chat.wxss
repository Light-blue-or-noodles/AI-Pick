/* pages/chat/chat.wxss */

.container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #f5f5f5;
}

/* 聊天头部 */
.chat-header {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20rpx 30rpx;
  background: #fff;
  border-bottom: 1rpx solid #eee;
}

.header-avatar {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  margin-right: 16rpx;
}

.header-nickname {
  font-size: 32rpx;
  font-weight: 500;
  color: #333;
}

.chat-content {
  flex: 1;
  padding: 20rpx;
  padding-bottom: 20rpx;
}

.chat-content.user-chat {
  background: #f8f9fa;
}

.message-wrapper {
  display: flex;
  margin-bottom: 30rpx;
  align-items: flex-start;
}

.message-wrapper.user {
  justify-content: flex-end;
}

.message-wrapper.other {
  justify-content: flex-start;
}

.message-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.ai-avatar {
  margin-right: 16rpx;
}

.other-avatar {
  margin-right: 16rpx;
}

.user-avatar {
  margin-left: 16rpx;
}

.message-bubble {
  max-width: 70%;
  padding: 20rpx 24rpx;
  border-radius: 16rpx;
  background: #fff;
  position: relative;
}

.message-wrapper.ai .message-bubble {
  border-top-left-radius: 4rpx;
  background: #fff;
}

.message-wrapper.other .message-bubble {
  border-top-left-radius: 4rpx;
  background: #fff;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.message-wrapper.user .message-bubble {
  background: linear-gradient(135deg, #FF6B6B 0%, #FF8E8E 100%);
  border-top-right-radius: 4rpx;
}

.message-text {
  font-size: 28rpx;
  line-height: 1.5;
  color: #333;
}

.message-wrapper.user .message-text {
  color: #fff;
}

.message-time {
  font-size: 20rpx;
  color: #999;
  margin-top: 8rpx;
  display: block;
  text-align: right;
}

.message-wrapper.user .message-time {
  color: rgba(255, 255, 255, 0.8);
}

/* 输入指示器 */
.typing-indicator {
  display: flex;
  align-items: center;
  padding: 20rpx 24rpx;
  background: #fff;
  border-radius: 16rpx;
  width: 100rpx;
  margin-left: 88rpx;
  margin-bottom: 30rpx;
}

.typing-dot {
  width: 12rpx;
  height: 12rpx;
  background: #ccc;
  border-radius: 50%;
  margin: 0 4rpx;
  animation: typing 1.4s infinite ease-in-out;
}

.typing-dot:nth-child(2) {
  animation-delay: 0.2s;
}

.typing-dot:nth-child(3) {
  animation-delay: 0.4s;
}

@keyframes typing {
  0%, 60%, 100% {
    transform: translateY(0);
  }
  30% {
    transform: translateY(-10rpx);
  }
}

/* 快捷回复 */
.quick-replies {
  display: flex;
  flex-wrap: wrap;
  padding: 16rpx 20rpx;
  background: #fff;
  border-top: 1rpx solid #eee;
}

.quick-reply {
  padding: 12rpx 20rpx;
  background: #f5f5f5;
  border-radius: 30rpx;
  font-size: 24rpx;
  color: #666;
  margin: 8rpx;
}

/* 输入区域 */
.input-area {
  display: flex;
  align-items: center;
  padding: 20rpx 30rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: #fff;
  border-top: 1rpx solid #eee;
}

.chat-input {
  flex: 1;
  padding: 20rpx 24rpx;
  background: #f5f5f5;
  border-radius: 40rpx;
  font-size: 28rpx;
}

.send-btn {
  width: 80rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-left: 16rpx;
}

.send-btn image {
  width: 48rpx;
  height: 48rpx;
}

/* 用户聊天特殊样式 */
.user-chat .message-wrapper {
  margin-bottom: 24rpx;
}

.user-chat .message-bubble {
  max-width: 65%;
}
