/* pages/index/index.wxss - 首页样式（薄荷青 + 柔和留白） */

@import '../../styles/variables.wxss';
@import '../../styles/common.wxss';

.container {
  background-color: var(--bg-color);
  min-height: 100vh;
  padding-bottom: var(--tab-bar-padding);
}

/* 顶部欢迎区 - 薄荷青渐变 */
.header {
  background: linear-gradient(135deg, #5FB3A8 0%, #7FC4BA 100%);
  padding: calc(40rpx + env(safe-area-inset-top)) var(--page-horizontal) 48rpx;
  color: #fff;
}

.welcome-text {
  font-size: var(--font-xxl);
  font-weight: 600;
  margin-bottom: 12rpx;
  line-height: var(--line-normal);
}

.greeting {
  font-weight: 400;
}

.username {
  font-weight: 700;
}

.header-subtitle {
  font-size: var(--font-base);
  opacity: 0.92;
  margin-top: 8rpx;
}

/* AI 智能助手入口 - 放大突出，使用小鲨鱼头像 */
.ai-entry {
  background: linear-gradient(135deg, #5FB3A8 0%, #7FC4BA 100%);
  margin: var(--block-gap) var(--page-horizontal);
  border-radius: var(--radius-xl);
  padding: var(--spacing-lg) var(--card-inner);
  padding-top: calc(var(--spacing-lg) + env(safe-area-inset-top));
  display: flex;
  align-items: center;
  box-shadow: var(--shadow-md);
  transition: opacity 0.2s ease;
  min-height: 180rpx;
}

.ai-entry:active {
  opacity: 0.95;
}

.ai-icon {
  width: 128rpx;
  height: 128rpx;
  background: rgba(255, 255, 255, 0.25);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 28rpx;
  flex-shrink: 0;
  overflow: hidden;
}

.ai-icon image {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.ai-content {
  flex: 1;
  min-width: 0;
}

.ai-title {
  display: block;
  font-size: 40rpx;
  font-weight: 600;
  color: #fff;
  margin-bottom: 10rpx;
}

.ai-desc {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.92);
  line-height: var(--line-normal);
}

.ai-arrow image {
  width: 36rpx;
  height: 36rpx;
}

/* 快捷入口 - 加大间距、柔和圆角 */
.quick-links {
  display: flex;
  justify-content: space-around;
  padding: 0 var(--page-horizontal) var(--block-gap);
}

.link-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.link-icon {
  width: 96rpx;
  height: 96rpx;
  background-color: var(--bg-white);
  border-radius: var(--radius-lg);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 12rpx;
  box-shadow: var(--shadow-sm);
  transition: transform 0.2s ease;
}

.link-icon:active {
  transform: scale(0.96);
}

.link-text {
  font-size: var(--font-sm);
  color: var(--text-secondary);
}

/* 首页快捷入口图标 - 与底部 tab 风格统一的扁平图形 */
.link-icon-inner {
  position: relative;
  width: 56rpx;
  height: 56rpx;
}

/* 找搭子：两个人物 */
.home-partner-head {
  position: absolute;
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #7BCDD0;
}

.home-partner-head-left {
  top: 8rpx;
  left: 8rpx;
}

.home-partner-head-right {
  top: 12rpx;
  right: 8rpx;
  background: #5FB3A8;
}

.home-partner-body {
  position: absolute;
  width: 22rpx;
  height: 18rpx;
  border-radius: 12rpx 12rpx 14rpx 14rpx;
  background: rgba(95, 179, 168, 0.18);
}

.home-partner-body-left {
  bottom: 6rpx;
  left: 6rpx;
}

.home-partner-body-right {
  bottom: 6rpx;
  right: 6rpx;
}

/* 区域标题 - 统一留白 */
.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: var(--block-gap) var(--page-horizontal) var(--spacing-sm);
}

.section-title {
  font-size: var(--font-lg);
  font-weight: 600;
  color: var(--text-primary);
}

.section-more {
  font-size: var(--font-base);
  color: var(--primary-color);
}

/* 附近动态 - 卡片留白与圆角 */
.nearby-section {
  margin-bottom: var(--block-gap);
}

.nearby-list {
  padding: 0 var(--page-horizontal);
}

.nearby-item {
  display: flex;
  background-color: var(--bg-white);
  border-radius: var(--radius-lg);
  padding: var(--card-inner);
  margin-bottom: var(--spacing-sm);
  box-shadow: var(--shadow-sm);
  transition: opacity 0.2s ease;
}

.nearby-item:active {
  opacity: 0.98;
}

.nearby-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.nearby-content {
  flex: 1;
  min-width: 0;
}

.nearby-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 10rpx;
}

.nearby-name {
  font-size: var(--font-base);
  font-weight: 500;
  color: var(--text-primary);
}

.nearby-time {
  font-size: var(--font-xs);
  color: var(--text-tertiary);
}

.nearby-text {
  font-size: var(--font-base);
  color: var(--text-primary);
  line-height: var(--line-normal);
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.nearby-images {
  display: flex;
  flex-wrap: wrap;
  gap: var(--spacing-xs);
  margin-top: 12rpx;
}

.nearby-img {
  width: 120rpx;
  height: 120rpx;
  border-radius: var(--radius-sm);
}

.nearby-meta {
  display: flex;
  gap: 20rpx;
  margin-top: 14rpx;
}

.meta-location, .meta-like, .meta-comment {
  font-size: var(--font-xs);
  color: var(--text-tertiary);
}

/* 推荐列表 - 卡片居中，不受全局 stretch 影响 */
.recommend-list {
  padding: 0 var(--page-horizontal) var(--block-gap);
  box-sizing: border-box;
}

.recommend-card {
  display: flex;
  flex-direction: row;
  align-items: stretch;
  background: var(--bg-white);
  border-radius: var(--radius-lg);
  margin-bottom: var(--card-gap);
  padding: var(--card-inner);
  box-shadow: var(--shadow-sm);
  transition: opacity 0.2s ease;
  box-sizing: border-box;
}

.recommend-card-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: row;
  align-items: flex-start;
}

.recommend-card-main:active {
  opacity: 0.98;
}

/* 搭子封面：矩形圆角，与列表一致 */
.recommend-thumb {
  width: 200rpx;
  min-width: 200rpx;
  height: 140rpx;
  flex-shrink: 0;
  border-radius: var(--radius-md);
  overflow: hidden;
  background: var(--bg-gray);
}

/* 文案区：与图片、按钮整体垂直居中 */
.recommend-body {
  display: flex;
  align-items: flex-start;
  flex: 1;
  min-width: 0;
  margin-left: var(--spacing-sm);
}

.recommend-body .recommend-info {
  flex: 1;
  min-width: 0;
}

.recommend-meta {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 12rpx 20rpx;
  margin-top: 12rpx;
}

.recommend-meta .meta-item {
  display: flex;
  align-items: center;
  gap: 6rpx;
  font-size: var(--font-xs);
  color: var(--text-tertiary);
}

.recommend-meta .meta-icon {
  width: 24rpx;
  height: 24rpx;
  flex-shrink: 0;
}

.meta-tag-icon {
  font-size: 22rpx;
}

.recommend-line {
  font-size: var(--font-sm);
  color: var(--text-secondary);
  margin-bottom: 8rpx;
  line-height: 1.4;
}

.recommend-line .rec-label {
  font-size: var(--font-xs);
  color: var(--text-tertiary);
  margin-right: 8rpx;
}

.recommend-line.nick-line {
  margin-bottom: 10rpx;
}

.recommend-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.recommend-name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.match-badge {
  display: flex;
  align-items: center;
  background: var(--primary-color);
  border-radius: var(--radius-sm);
  padding: 6rpx 14rpx;
}

.match-num {
  font-size: 22rpx;
  font-weight: 600;
  color: #fff;
  margin-right: 4rpx;
}

.match-label {
  font-size: 18rpx;
  color: rgba(255, 255, 255, 0.9);
}

.recommend-tags {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  margin-bottom: 12rpx;
}

.recommend-list .tag {
  display: inline-block;
  padding: 8rpx 20rpx;
  font-size: var(--font-sm);
  font-weight: 500;
  border-radius: var(--radius-sm);
  background: var(--primary-color);
  color: #fff;
  margin-right: 10rpx;
}

.distance-tag {
  font-size: var(--font-xs);
  color: var(--text-tertiary);
}

.recommend-action {
  margin-left: var(--spacing-sm);
  display: flex;
  flex-direction: column;
  align-items: stretch;
  justify-content: center;
  flex-shrink: 0;
  gap: 10rpx;
}

.btn-rec {
  padding: 10rpx 18rpx;
  font-size: 22rpx;
  border-radius: var(--radius-full);
  text-align: center;
  white-space: nowrap;
  transition: opacity 0.2s ease;
}

.btn-rec:active {
  opacity: 0.9;
}

.btn-skip {
  background: rgba(0, 0, 0, 0.06);
  color: var(--text-secondary);
}

.btn-incompat {
  background: rgba(217, 83, 79, 0.12);
  color: #c45c5c;
}

.btn-chat {
  padding: 10rpx 18rpx;
  background: var(--primary-color);
  color: #fff;
  font-size: 22rpx;
  border-radius: var(--radius-full);
  white-space: nowrap;
}

.loading {
  display: flex;
  justify-content: center;
  padding: var(--spacing-lg);
  color: var(--text-tertiary);
  font-size: var(--font-base);
}
