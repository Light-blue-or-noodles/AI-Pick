<!--pages/profile/profile.wxml-->
<view class="container">
  <!-- 顶部背景 -->
  <view class="profile-header">
    <view class="header-bg"></view>
    
    <!-- 用户信息 -->
    <view class="user-info" bindtap="onAvatarClick">
      <view class="avatar-wrap">
        <network-image class="avatar" customClass="avatar" url="{{userInfo.avatar}}" defaultSrc="/images/default-avatar.png" mode="aspectFill" preferDownloadInDevtools="{{true}}" />
        <view class="login-badge" wx:if="{{!userInfo.isLogin}}">登录</view>
      </view>
      <view class="user-detail">
        <text class="nickname">{{userInfo.nickname}}</text>
        <text class="bio" wx:if="{{userInfo.isLogin}}">{{userInfo.bio && userInfo.bio !== 'null' ? userInfo.bio : '设置你的个性签名'}}</text>
        <text class="bio" wx:else>登录后享受更多功能</text>
        <!-- 公司和学校信息 -->
        <view class="org-info" wx:if="{{userInfo.isLogin}}">
          <text class="org-item" wx:if="{{userInfo.companyName}}">🏢 {{userInfo.companyName}}</text>
          <text class="org-item" wx:if="{{userInfo.schoolName}}">🎓 {{userInfo.schoolName}}</text>
        </view>
      </view>
      <image class="edit-icon" src="/images/edit.png" bindtap="editProfile" wx:if="{{userInfo.isLogin}}" />
    </view>

    <!-- 统计数据 -->
    <view class="stats" wx:if="{{userInfo.isLogin}}">
      <view class="stat-item">
        <text class="stat-value">{{stats.partners}}</text>
        <text class="stat-label">搭子</text>
      </view>
      <view class="stat-divider"></view>
      <view class="stat-item">
        <text class="stat-value">{{stats.activities}}</text>
        <text class="stat-label">活动</text>
      </view>
      <view class="stat-divider"></view>
      <view class="stat-item">
        <text class="stat-value">{{stats.messages}}</text>
        <text class="stat-label">消息</text>
      </view>
    </view>
  </view>

  <!-- 功能菜单 -->
  <view class="menu-section">
    <block wx:for="{{menuItems}}" wx:key="id">
      <view class="menu-item" bindtap="onMenuItemClick" data-id="{{item.id}}">
        <view class="menu-left">
          <image class="menu-icon" src="{{item.icon}}" mode="aspectFit" />
          <text class="menu-title">{{item.title}}</text>
        </view>
        <image class="menu-arrow" src="/images/arrow-right.png" mode="aspectFit" wx:if="{{item.arrow}}" />
      </view>
    </block>
  </view>

  <!-- 版本信息 -->
  <view class="version-info">
    <text>AI-Pick AI v1.0.0</text>
  </view>
</view>