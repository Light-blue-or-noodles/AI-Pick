/* pages/profile/profile.wxss - 我的页样式 */

@import '../../styles/variables.wxss';
@import '../../styles/common.wxss';
@import '../../styles/profile.wxss';

/* 底部留出 Tab 栏高度，避免内容被遮挡 */
.container {
  padding-bottom: var(--tab-bar-padding);
  box-sizing: border-box;
}

.profile-header {
  position: relative;
  background: linear-gradient(135deg, #4A90D9 0%, #6BA3E0 100%);
  padding: 60rpx 30rpx 40rpx;
}

.header-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(180deg, rgba(74, 144, 217, 0.2) 0%, transparent 100%);
}

/* 用户信息 */
.user-info {
  position: relative;
  display: flex;
  align-items: center;
  z-index: 1;
}

.avatar-wrap {
  position: relative;
}

.avatar {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  border: 6rpx solid rgba(255, 255, 255, 0.5);
}

.login-badge {
  position: absolute;
  bottom: 0;
  right: 0;
  padding: 4rpx 12rpx;
  background: var(--success-color);
  color: #fff;
  font-size: 20rpx;
  border-radius: 20rpx;
}

.user-detail {
  flex: 1;
  margin-left: 24rpx;
}

.nickname {
  display: block;
  font-size: 36rpx;
  font-weight: 600;
  color: #fff;
  margin-bottom: 8rpx;
}

.bio {
  font-size: var(--font-sm);
  color: rgba(255, 255, 255, 0.9);
}

.org-info {
  display: flex;
  flex-wrap: wrap;
  margin-top: 12rpx;
  gap: 16rpx;
}

.org-item {
  font-size: var(--font-xs);
  color: rgba(255, 255, 255, 0.95);
  background: rgba(255, 255, 255, 0.2);
  padding: 6rpx 16rpx;
  border-radius: var(--radius-full);
}

.edit-icon {
  width: 40rpx;
  height: 40rpx;
  padding: 10rpx;
}

/* 统计数据 */
.stats {
  position: relative;
  display: flex;
  justify-content: space-around;
  align-items: center;
  margin-top: 40rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: var(--radius-lg);
  padding: 30rpx;
  z-index: 1;
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-value {
  font-size: 40rpx;
  font-weight: 600;
  color: #fff;
}

.stat-label {
  font-size: var(--font-sm);
  color: rgba(255, 255, 255, 0.9);
  margin-top: 8rpx;
}

.stat-divider {
  width: 1rpx;
  height: 60rpx;
  background: rgba(255, 255, 255, 0.3);
}

/* 功能菜单 */
.menu-section {
  background: var(--bg-white);
  margin: 20rpx;
  border-radius: var(--radius-lg);
  overflow: hidden;
}

.menu-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
  border-bottom: 1rpx solid var(--border-color);
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-item:active {
  background: var(--bg-gray);
}

.menu-left {
  display: flex;
  align-items: center;
}

.menu-icon {
  width: 44rpx;
  height: 44rpx;
  margin-right: 20rpx;
}

.menu-title {
  font-size: var(--font-base);
  color: var(--text-primary);
}

.menu-arrow {
  width: 28rpx;
  height: 28rpx;
  opacity: 0.4;
}

/* 版本信息 */
.version-info {
  text-align: center;
  padding: var(--spacing-lg);
  color: var(--text-disabled);
  font-size: var(--font-sm);
}