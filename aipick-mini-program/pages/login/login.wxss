/* pages/login/login.wxss - 暖白色背景 */

.login-container {
  min-height: 100vh;
  background: linear-gradient(180deg, #FDF8F5 0%, #FAF6F2 50%, #F8F4F0 100%);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: space-between;
  padding: 120rpx 60rpx 60rpx;
  box-sizing: border-box;
}

/* Logo Area */
.logo-area {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 60rpx;
}

.logo {
  width: 160rpx;
  height: 160rpx;
  background: linear-gradient(135deg, var(--primary-color) 0%, var(--primary-light) 100%);
  border-radius: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 32rpx rgba(95, 179, 168, 0.25);
}

.logo-icon {
  font-size: 80rpx;
}

.app-name {
  font-size: 56rpx;
  font-weight: bold;
  color: #333333;
  margin-top: 32rpx;
}

.app-slogan {
  font-size: 28rpx;
  color: #666666;
  margin-top: 16rpx;
}

/* Login Buttons */
.login-buttons {
  width: 100%;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.btn-login {
  width: 100%;
  height: 96rpx;
  white-space: nowrap;
  border-radius: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  border: none;
}

.btn-login::after {
  border: none;
}

.btn-phone {
  background: var(--primary-color);
  color: #ffffff;
}

.btn-phone:active {
  background: var(--primary-dark);
}

.btn-wechat {
  background: #07C160;
  color: #ffffff;
}

.btn-wechat:active {
  background: #06AD56;
}

.btn-icon {
  font-size: 36rpx;
  margin-right: 16rpx;
}

.btn-text {
  font-weight: 500;
  white-space: nowrap;
}

/* Agreement Area - 复选框与协议文案、确认在一行显示 */
.agreement-area {
  padding: 0 20rpx;
  width: 100%;
  box-sizing: border-box;
}

.checkbox-wrapper {
  display: flex;
  flex-wrap: nowrap;
  align-items: center;
  justify-content: center;
  overflow-x: auto;
  overflow-y: hidden;
}

.checkbox {
  width: 36rpx;
  height: 36rpx;
  border: 2rpx solid rgba(0, 0, 0, 0.18);
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 12rpx;
  flex-shrink: 0;
}

.checkbox.checked {
  background: var(--primary-color);
  border-color: var(--primary-color);
}

.check-icon {
  color: #ffffff;
  font-size: 24rpx;
  font-weight: bold;
}

.agreement-text {
  font-size: 24rpx;
  color: #666666;
  line-height: 1.6;
  white-space: nowrap;
  flex-shrink: 0;
}

.link {
  color: var(--primary-color);
  text-decoration: underline;
}

/* Loading */
.loading-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.loading-content {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid rgba(255, 255, 255, 0.3);
  border-top-color: #ffffff;
  border-radius: 50%;
  animation: spin 1s linear infinite;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

.loading-text {
  color: #ffffff;
  font-size: 28rpx;
  margin-top: 20rpx;
}