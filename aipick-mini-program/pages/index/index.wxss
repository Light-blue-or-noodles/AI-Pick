/* pages/index/index.wxss - 首页样式 */

@import '../../styles/variables.wxss';
@import '../../styles/common.wxss';
@import '../../styles/home.wxss';

.container {
  background-color: var(--bg-color);
  min-height: 100vh;
  /* 底部留出 tab 栏高度，避免内容被遮挡 */
  padding-bottom: var(--tab-bar-padding);
}

.header {
  background: linear-gradient(135deg, #FF8A65 0%, #FFAB91 100%);
  padding: 40rpx 30rpx 60rpx;
  color: #fff;
}

.welcome-text {
  font-size: 44rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}

.greeting {
  font-weight: 400;
}

.username {
  font-weight: 700;
}

.header-subtitle {
  font-size: 28rpx;
  opacity: 0.9;
  margin-top: 8rpx;
}

/* AI 对话入口 - 突出显示 */
.ai-entry {
  background: linear-gradient(135deg, #FF8A65 0%, #FFAB91 100%);
  margin: 30rpx 30rpx 40rpx;
  border-radius: var(--radius-xl);
  padding: 40rpx 30rpx;
  display: flex;
  align-items: center;
  box-shadow: 0 8rpx 32rpx rgba(255, 138, 101, 0.3);
  position: relative;
}

.ai-icon {
  width: 100rpx;
  height: 100rpx;
  background: rgba(255, 255, 255, 0.25);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.ai-icon image {
  width: 60rpx;
  height: 60rpx;
}

.ai-content {
  flex: 1;
}

.ai-title {
  display: block;
  font-size: 36rpx;
  font-weight: 600;
  color: #fff;
  margin-bottom: 12rpx;
}

.ai-desc {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.9);
}

.ai-arrow image {
  width: 36rpx;
  height: 36rpx;
}

/* 快捷入口 */
.quick-links {
  display: flex;
  justify-content: space-around;
  padding: 0 30rpx 30rpx;
}

.link-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.link-icon {
  width: 100rpx;
  height: 100rpx;
  background-color: var(--bg-white);
  border-radius: var(--radius-lg);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  margin-bottom: 10rpx;
  box-shadow: var(--shadow-sm);
}

.link-text {
  font-size: var(--font-sm);
  color: var(--text-secondary);
}

/* 区域标题 */
.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 30rpx;
}

.section-title {
  font-size: var(--font-lg);
  font-weight: 600;
  color: var(--text-primary);
}

.section-more {
  font-size: var(--font-base);
  color: var(--primary-color);
}

