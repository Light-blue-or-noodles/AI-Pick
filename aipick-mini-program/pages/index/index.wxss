/* 附近动态 */
.nearby-section {
  margin-bottom: 20rpx;
}

.nearby-list {
  padding: 0 30rpx;
}

.nearby-item {
  display: flex;
  background-color: var(--bg-white);
  border-radius: var(--radius-lg);
  padding: 20rpx;
  margin-bottom: 16rpx;
}

.nearby-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.nearby-content {
  flex: 1;
  min-width: 0;
}

.nearby-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}

.nearby-name {
  font-size: var(--font-base);
  font-weight: 500;
  color: var(--text-primary);
}

.nearby-time {
  font-size: var(--font-xs);
  color: var(--text-tertiary);
}

.nearby-text {
  font-size: var(--font-base);
  color: var(--text-primary);
  line-height: 1.5;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.nearby-images {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 10rpx;
}

.nearby-img {
  width: 120rpx;
  height: 120rpx;
  border-radius: var(--radius-sm);
}

.nearby-meta {
  display: flex;
  gap: 20rpx;
  margin-top: 12rpx;
}

.meta-location, .meta-like, .meta-comment {
  font-size: var(--font-xs);
  color: var(--text-tertiary);
}

/* 推荐列表 */
.recommend-list {
  padding: 0 20rpx;
}

.recommend-card {
  background: var(--bg-white);
  border-radius: var(--radius-lg);
  padding: 24rpx;
  margin-bottom: 20rpx;
  display: flex;
  align-items: flex-start;
  box-shadow: var(--shadow-sm);
}

.recommend-avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.recommend-info {
  flex: 1;
  min-width: 0;
}

.recommend-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 10rpx;
}

.recommend-name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.match-badge {
  display: flex;
  align-items: center;
  background: linear-gradient(135deg, var(--accent-color) 0%, var(--accent-light) 100%);
  border-radius: 20rpx;
  padding: 4rpx 12rpx;
}

.match-num {
  font-size: 22rpx;
  font-weight: 600;
  color: #fff;
  margin-right: 4rpx;
}

.match-label {
  font-size: 18rpx;
  color: rgba(255, 255, 255, 0.9);
}

.recommend-tags {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  margin-bottom: 10rpx;
}

.tag {
  display: inline-block;
  padding: 6rpx 14rpx;
  font-size: var(--font-xs);
  border-radius: var(--radius-sm);
  background: var(--secondary-color);
  color: var(--primary-color);
  margin-right: 10rpx;
}

.distance-tag {
  font-size: var(--font-xs);
  color: var(--text-tertiary);
}

.recommend-bio {
  font-size: var(--font-sm);
  color: var(--text-secondary);
  display: -webkit-box;
  -webkit-line-clamp: 1;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.recommend-action {
  margin-left: 20rpx;
  display: flex;
  align-items: center;
}

.btn-chat {
  padding: 12rpx 24rpx;
  background: var(--primary-color);
  color: #fff;
  font-size: var(--font-sm);
  border-radius: var(--radius-full);
  white-space: nowrap;
}

.loading {
  display: flex;
  justify-content: center;
  padding: var(--spacing-lg);
  color: var(--text-tertiary);
  font-size: var(--font-base);
}