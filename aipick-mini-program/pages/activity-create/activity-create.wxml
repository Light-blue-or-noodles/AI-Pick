<!--pages/activity-create/activity-create.wxml-->
<view class="container">
  <!-- Form（返回使用小程序自带导航栏） -->
  <view class="form">
    <!-- 多图上传：第一张为封面，其余在详情展示 -->
    <view class="form-item">
      <text class="form-label">活动图片</text>
      <text class="form-tip">首张为封面，可上传多张（最多9张）</text>
      <view class="image-list">
        <view 
          class="image-item" 
          wx:for="{{imageList}}" 
          wx:key="index"
        >
          <image class="image-preview" src="{{item}}" mode="aspectFill" />
          <view class="image-cover-tag" wx:if="{{index === 0}}">封面</view>
          <view class="image-delete" bindtap="onRemoveImage" data-index="{{index}}">×</view>
        </view>
        <view class="image-add" bindtap="onChooseImages" wx:if="{{imageList.length < 9}}">
          <text class="image-add-icon">+</text>
          <text class="image-add-text">添加图片</text>
        </view>
      </view>
    </view>

    <!-- 标题 -->
    <view class="form-item">
      <view class="form-label-row">
        <text class="form-label">活动标题</text>
        <text class="form-count">{{titleLength}}/30</text>
      </view>
      <input 
        class="form-input" 
        placeholder="请输入活动标题..." 
        value="{{title}}"
        maxlength="30"
        bindinput="onTitleInput"
      />
    </view>

    <!-- 活动类型 -->
    <view class="form-item">
      <text class="form-label">活动类型</text>
      <view class="category-tags">
        <text 
          class="category-tag {{category === item.value ? 'active' : ''}}"
          wx:for="{{categories}}"
          wx:key="value"
          bindtap="onSelectCategory"
          data-value="{{item.value}}"
        >{{item.label}}</text>
      </view>
    </view>

    <!-- 活动时间 -->
    <view class="form-item">
      <text class="form-label">活动时间</text>
      <view class="datetime-group">
        <view class="datetime-row">
          <text class="datetime-row-label">开始时间</text>
          <picker mode="multiSelector"
                  range="{{dateTimeRange}}"
                  value="{{startDateTimeIndex}}"
                  bindchange="onStartDateTimeChange">
            <view class="picker-item picker-item-single">
              <view class="picker-icon picker-icon-calendar"></view>
              <text class="{{startDateTimeText ? 'picker-value' : 'picker-placeholder'}}">
                {{startDateTimeText || '选择开始时间'}}
              </text>
            </view>
          </picker>
        </view>
        <view class="datetime-row">
          <text class="datetime-row-label">结束时间</text>
          <picker mode="multiSelector"
                  range="{{dateTimeRange}}"
                  value="{{endDateTimeIndex}}"
                  bindchange="onEndDateTimeChange">
            <view class="picker-item picker-item-single">
              <view class="picker-icon picker-icon-calendar"></view>
              <text class="{{endDateTimeText ? 'picker-value' : 'picker-placeholder'}}">
                {{endDateTimeText || '选择结束时间'}}
              </text>
            </view>
          </picker>
        </view>
      </view>
    </view>

    <!-- 活动地点：腾讯地图选点 -->
    <view class="form-item">
      <text class="form-label">活动地点</text>
      <view class="location-input" bindtap="onChooseLocation">
        <view class="location-icon-pin">
          <view class="location-icon-pin-head"></view>
          <view class="location-icon-pin-tail"></view>
        </view>
        <text class="{{location ? 'location-value' : 'location-placeholder'}}">
          {{location || '点击使用地图选点...'}}
        </text>
      </view>
    </view>

    <!-- Max Participants -->
    <view class="form-item">
      <text class="form-label">人数限制</text>
      <view class="counter">
        <view 
          class="counter-btn {{maxParticipants <= 2 ? 'disabled' : ''}}"
          bindtap="onDecreaseCount"
        >
          <text>-</text>
        </view>
        <view class="counter-value">
          <text class="count-number">{{maxParticipants}}</text>
          <text class="count-unit">人</text>
        </view>
        <view 
          class="counter-btn {{maxParticipants >= 100 ? 'disabled' : ''}}"
          bindtap="onIncreaseCount"
        >
          <text>+</text>
        </view>
      </view>
    </view>

    <!-- 费用 -->
    <view class="form-item">
      <text class="form-label">费用</text>
      <view class="price-type-tags">
        <text 
          class="price-tag {{priceType === 'free' ? 'active' : ''}}"
          bindtap="onSelectPriceType"
          data-type="free"
        >免费</text>
        <text 
          class="price-tag {{priceType === 'paid' ? 'active' : ''}}"
          bindtap="onSelectPriceType"
          data-type="paid"
        >付费</text>
      </view>
      <view class="price-input" wx:if="{{priceType === 'paid'}}">
        <text class="price-unit">¥</text>
        <input 
          class="price-value" 
          type="digit" 
          placeholder="输入金额" 
          value="{{price}}"
          bindinput="onPriceInput"
        />
      </view>
    </view>

    <!-- 活动详情 -->
    <view class="form-item">
      <view class="form-label-row">
        <text class="form-label">活动详情</text>
        <text class="form-count">{{descLength}}/500</text>
      </view>
      <textarea 
        class="form-textarea" 
        placeholder="请输入活动详情..." 
        value="{{description}}"
        maxlength="500"
        bindinput="onDescInput"
      />
    </view>

    <!-- AI 帮我完善（统一图标风格） -->
    <view class="ai-btn" bindtap="onAIComplete">
      <view class="ai-icon-mark">
        <view class="ai-icon-circle"></view>
        <view class="ai-icon-spark"></view>
      </view>
      <text class="ai-text">AI 帮我完善</text>
    </view>

    <!-- Submit Button -->
    <view class="submit-btn" bindtap="onSubmit">
      <text>发布活动</text>
    </view>
  </view>
</view>