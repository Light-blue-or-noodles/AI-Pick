/* pages/activity-create/activity-create.wxss - 薄荷青 + 柔和留白 */

@import '../../styles/variables.wxss';

.container {
  min-height: 100vh;
  background: var(--bg-color);
}

/* Form */
.form {
  padding: 32rpx;
}

.form-item {
  margin-bottom: 40rpx;
}

.form-label-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.form-label {
  font-size: 30rpx;
  font-weight: 500;
  color: #1A1A1A;
  display: block;
  margin-bottom: 16rpx;
}

.form-count {
  font-size: 24rpx;
  color: #999999;
}

.form-tip {
  font-size: 24rpx;
  color: #999999;
  display: block;
  margin-bottom: 16rpx;
}

/* 多图上传 */
.image-list {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.image-item {
  position: relative;
  width: 200rpx;
  height: 200rpx;
  border-radius: 12rpx;
  overflow: hidden;
  background: #eee;
}

.image-preview {
  width: 100%;
  height: 100%;
}

.image-cover-tag {
  position: absolute;
  left: 0;
  bottom: 0;
  right: 0;
  padding: 6rpx;
  font-size: 20rpx;
  color: #fff;
  background: rgba(0,0,0,0.5);
  text-align: center;
}

.image-delete {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: rgba(0,0,0,0.5);
  color: #fff;
  font-size: 36rpx;
  line-height: 44rpx;
  text-align: center;
}

.image-add {
  width: 200rpx;
  height: 200rpx;
  border-radius: 12rpx;
  border: 2rpx dashed #E5E5E5;
  background: #fff;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.image-add-icon {
  font-size: 48rpx;
  color: #999;
}

.image-add-text {
  font-size: 24rpx;
  color: #999;
  margin-top: 8rpx;
}

/* Form Input */
.form-input {
  background: #ffffff;
  border-radius: 12rpx;
  padding: 24rpx;
  font-size: 30rpx;
  color: #333333;
  border: 1rpx solid #E5E5E5;
}

.form-input::placeholder {
  color: #999999;
}

/* Category Tags */
.category-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.category-tag {
  padding: 16rpx 32rpx;
  background: #ffffff;
  border: 1rpx solid #E5E5E5;
  border-radius: 32rpx;
  font-size: 28rpx;
  color: #666666;
}

.category-tag.active {
  background: var(--primary-color);
  border-color: var(--primary-color);
  color: #ffffff;
}

/* DateTime Picker */
.datetime-group {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.datetime-row {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.datetime-row-label {
  font-size: 26rpx;
  color: #666666;
}

.datetime-picker {
  display: flex;
  gap: 20rpx;
}

.picker-item {
  flex: 1;
  background: #ffffff;
  border-radius: 12rpx;
  padding: 24rpx;
  border: 1rpx solid #E5E5E5;
  display: flex;
  align-items: center;
}

.picker-item-single {
  width: 100%;
}

.picker-icon {
  width: 32rpx;
  height: 32rpx;
  margin-right: 12rpx;
  margin-top: 4rpx;
  position: relative;
  flex-shrink: 0;
}

.picker-icon-calendar::before,
.picker-icon-calendar::after {
  content: '';
  position: absolute;
  left: 2rpx;
  right: 2rpx;
  border-radius: 6rpx;
}

.picker-icon-calendar::before {
  top: 2rpx;
  height: 10rpx;
  background: #5FB3A8;
}

.picker-icon-calendar::after {
  top: 10rpx;
  bottom: 2rpx;
  background: #ffffff;
  border: 2rpx solid #5FB3A8;
  border-top: none;
  box-sizing: border-box;
}

.picker-icon-clock::before,
.picker-icon-clock::after {
  content: '';
  position: absolute;
}

.picker-icon-clock::before {
  top: 2rpx;
  left: 2rpx;
  right: 2rpx;
  bottom: 2rpx;
  border-radius: 50%;
  border: 2rpx solid #5FB3A8;
  box-sizing: border-box;
}

.picker-icon-clock::after {
  top: 8rpx;
  left: 16rpx;
  width: 8rpx;
  height: 10rpx;
  border-radius: 2rpx;
  background: #5FB3A8;
  transform-origin: 0 100%;
  transform: rotate(30deg);
}

.picker-value {
  font-size: 28rpx;
  color: #333333;
  line-height: 1;
}

.picker-placeholder {
  font-size: 28rpx;
  color: #999999;
  line-height: 1;
}

/* Location Input */
.location-input {
  background: #ffffff;
  border-radius: 12rpx;
  padding: 24rpx;
  border: 1rpx solid #E5E5E5;
  display: flex;
  align-items: center;
}

.location-icon-pin {
  width: 28rpx;
  height: 32rpx;
  margin-right: 12rpx;
  margin-top: 4rpx;
  position: relative;
  flex-shrink: 0;
}

.location-icon-pin-head {
  position: absolute;
  top: 0;
  left: 4rpx;
  right: 4rpx;
  height: 18rpx;
  border-radius: 14rpx 14rpx 10rpx 10rpx;
  background: #5FB3A8;
}

.location-icon-pin-tail {
  position: absolute;
  bottom: 2rpx;
  left: 50%;
  width: 8rpx;
  height: 8rpx;
  transform: translateX(-50%) rotate(45deg);
  border-radius: 2rpx;
  background: #5FB3A8;
}

.location-value {
  font-size: 28rpx;
  color: #333333;
  line-height: 1;
}

.location-placeholder {
  font-size: 28rpx;
  color: #999999;
  line-height: 1;
}

/* Counter */
.counter {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 40rpx;
  padding: 20rpx 0;
}

.counter-btn {
  width: 80rpx;
  height: 80rpx;
  background: var(--primary-color);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  color: #ffffff;
}

.counter-btn.disabled {
  background: #E5E5E5;
  color: #999999;
}

.counter-value {
  display: flex;
  align-items: baseline;
  min-width: 120rpx;
  justify-content: center;
}

.count-number {
  font-size: 48rpx;
  font-weight: 600;
  color: #1A1A1A;
}

.count-unit {
  font-size: 28rpx;
  color: #666666;
  margin-left: 8rpx;
}

/* Price Tags */
.price-type-tags {
  display: flex;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.price-tag {
  padding: 16rpx 32rpx;
  background: #ffffff;
  border: 1rpx solid #E5E5E5;
  border-radius: 32rpx;
  font-size: 28rpx;
  color: #666666;
}

.price-tag.active {
  background: var(--primary-color);
  border-color: var(--primary-color);
  color: #ffffff;
}

.price-input {
  display: flex;
  align-items: center;
  background: #ffffff;
  border-radius: 12rpx;
  padding: 0 24rpx;
  border: 1rpx solid #E5E5E5;
}

.price-unit {
  font-size: 32rpx;
  color: #666666;
}

.price-value {
  flex: 1;
  padding: 24rpx;
  font-size: 30rpx;
  color: #333333;
}

/* Textarea */
.form-textarea {
  background: #ffffff;
  border-radius: 12rpx;
  padding: 24rpx;
  font-size: 30rpx;
  color: #333333;
  border: 1rpx solid #E5E5E5;
  width: 100%;
  height: 240rpx;
  box-sizing: border-box;
}

.form-textarea::placeholder {
  color: #999999;
}

/* AI Button */
.ai-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  padding: 24rpx;
  background: linear-gradient(135deg, #667EEA 0%, #764BA2 100%);
  border-radius: 48rpx;
  margin-bottom: 32rpx;
}

.ai-icon-mark {
  position: relative;
  width: 32rpx;
  height: 32rpx;
}

.ai-icon-circle {
  position: absolute;
  inset: 4rpx;
  border-radius: 50%;
  border: 2rpx solid #ffffff;
  opacity: 0.9;
}

.ai-icon-spark {
  position: absolute;
  top: 2rpx;
  right: 4rpx;
  width: 8rpx;
  height: 12rpx;
  border-radius: 4rpx;
  background: #ffffff;
}

.ai-text {
  font-size: 30rpx;
  color: #ffffff;
  font-weight: 500;
}

/* Submit Button */
.submit-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 96rpx;
  background: var(--primary-color);
  border-radius: var(--radius-full);
  font-size: var(--font-xl);
  color: #ffffff;
  font-weight: 500;
  transition: opacity 0.2s ease;
}

.submit-btn:active {
  opacity: 0.95;
}