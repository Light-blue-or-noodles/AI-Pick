/* pages/activity-create/activity-create.wxss */

.container {
  min-height: 100vh;
  background: #F5F5F5;
}

/* Header */
.header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 88rpx;
  padding: 0 24rpx;
  background: #ffffff;
  border-bottom: 1rpx solid #E5E5E5;
  position: sticky;
  top: 0;
  z-index: 10;
}

.back-btn {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.back-icon {
  font-size: 40rpx;
  color: #333333;
}

.header-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #1A1A1A;
}

/* Form */
.form {
  padding: 32rpx;
}

.form-item {
  margin-bottom: 40rpx;
}

.form-label-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.form-label {
  font-size: 30rpx;
  font-weight: 500;
  color: #1A1A1A;
  display: block;
  margin-bottom: 16rpx;
}

.form-count {
  font-size: 24rpx;
  color: #999999;
}

/* Cover Upload */
.cover-upload {
  width: 100%;
  height: 300rpx;
  background: #ffffff;
  border-radius: 16rpx;
  border: 2rpx dashed #E5E5E5;
  overflow: hidden;
}

.cover-image {
  width: 100%;
  height: 100%;
}

.cover-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.cover-add-icon {
  font-size: 60rpx;
  color: #999999;
}

.cover-add-text {
  font-size: 28rpx;
  color: #999999;
  margin-top: 12rpx;
}

.cover-tip {
  font-size: 22rpx;
  color: #CCCCCC;
  margin-top: 8rpx;
}

/* Form Input */
.form-input {
  background: #ffffff;
  border-radius: 12rpx;
  padding: 24rpx;
  font-size: 30rpx;
  color: #333333;
  border: 1rpx solid #E5E5E5;
}

.form-input::placeholder {
  color: #999999;
}

/* Category Tags */
.category-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.category-tag {
  padding: 16rpx 32rpx;
  background: #ffffff;
  border: 1rpx solid #E5E5E5;
  border-radius: 32rpx;
  font-size: 28rpx;
  color: #666666;
}

.category-tag.active {
  background: #FF6B35;
  border-color: #FF6B35;
  color: #ffffff;
}

/* DateTime Picker */
.datetime-picker {
  display: flex;
  gap: 20rpx;
}

.picker-item {
  flex: 1;
  background: #ffffff;
  border-radius: 12rpx;
  padding: 24rpx;
  border: 1rpx solid #E5E5E5;
  display: flex;
  align-items: center;
}

.picker-icon {
  font-size: 32rpx;
  margin-right: 12rpx;
}

.picker-value {
  font-size: 28rpx;
  color: #333333;
}

.picker-placeholder {
  font-size: 28rpx;
  color: #999999;
}

/* Location Input */
.location-input {
  background: #ffffff;
  border-radius: 12rpx;
  padding: 24rpx;
  border: 1rpx solid #E5E5E5;
  display: flex;
  align-items: center;
}

.location-icon {
  font-size: 32rpx;
  margin-right: 12rpx;
}

.location-value {
  font-size: 28rpx;
  color: #333333;
}

.location-placeholder {
  font-size: 28rpx;
  color: #999999;
}

/* Counter */
.counter {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 40rpx;
  padding: 20rpx 0;
}

.counter-btn {
  width: 80rpx;
  height: 80rpx;
  background: #FF6B35;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  color: #ffffff;
}

.counter-btn.disabled {
  background: #E5E5E5;
  color: #999999;
}

.counter-value {
  display: flex;
  align-items: baseline;
  min-width: 120rpx;
  justify-content: center;
}

.count-number {
  font-size: 48rpx;
  font-weight: 600;
  color: #1A1A1A;
}

.count-unit {
  font-size: 28rpx;
  color: #666666;
  margin-left: 8rpx;
}

/* Price Tags */
.price-type-tags {
  display: flex;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.price-tag {
  padding: 16rpx 32rpx;
  background: #ffffff;
  border: 1rpx solid #E5E5E5;
  border-radius: 32rpx;
  font-size: 28rpx;
  color: #666666;
}

.price-tag.active {
  background: #FF6B35;
  border-color: #FF6B35;
  color: #ffffff;
}

.price-input {
  display: flex;
  align-items: center;
  background: #ffffff;
  border-radius: 12rpx;
  padding: 0 24rpx;
  border: 1rpx solid #E5E5E5;
}

.price-unit {
  font-size: 32rpx;
  color: #666666;
}

.price-value {
  flex: 1;
  padding: 24rpx;
  font-size: 30rpx;
  color: #333333;
}

/* Textarea */
.form-textarea {
  background: #ffffff;
  border-radius: 12rpx;
  padding: 24rpx;
  font-size: 30rpx;
  color: #333333;
  border: 1rpx solid #E5E5E5;
  width: 100%;
  height: 240rpx;
  box-sizing: border-box;
}

.form-textarea::placeholder {
  color: #999999;
}

/* AI Button */
.ai-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  padding: 24rpx;
  background: linear-gradient(135deg, #667EEA 0%, #764BA2 100%);
  border-radius: 48rpx;
  margin-bottom: 32rpx;
}

.ai-icon {
  font-size: 36rpx;
}

.ai-text {
  font-size: 30rpx;
  color: #ffffff;
  font-weight: 500;
}

/* Submit Button */
.submit-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 96rpx;
  background: #FF6B35;
  border-radius: 48rpx;
  font-size: 34rpx;
  color: #ffffff;
  font-weight: 500;
}