/* pages/filter/filter.wxss */
@import '../../styles/variables.wxss';

.container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background-color: var(--bg-color);
}

/* 筛选内容（顶部使用导航栏，无自定义 header） */
.filter-content {
  flex: 1;
  padding: var(--spacing-md) var(--page-horizontal) 180rpx;
  padding-top: calc(var(--spacing-md) + env(safe-area-inset-top));
  overflow-y: auto;
}

.filter-section {
  margin-bottom: var(--block-gap);
  background-color: var(--bg-white);
  border-radius: var(--radius-lg);
  padding: var(--card-inner);
  box-shadow: var(--shadow-sm);
}

.section-title {
  font-size: 30rpx;
  font-weight: 500;
  color: var(--text-primary);
  margin-bottom: var(--spacing-sm);
}

.filter-options {
  display: flex;
  flex-wrap: wrap;
  gap: var(--spacing-sm);
}

.option-item {
  padding: 16rpx 28rpx;
  background-color: var(--bg-gray);
  border-radius: var(--radius-full);
  font-size: 28rpx;
  color: var(--text-secondary);
  border: 2rpx solid var(--border-light);
  transition: background 0.2s ease, color 0.2s ease, border-color 0.2s ease;
}

.option-item.active {
  background-color: var(--primary-bg);
  color: var(--primary-color);
  border-color: var(--primary-color);
}

/* 底部栏：左下角重置 + 中间结果数 + 右侧应用筛选 */
.bottom-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--spacing-sm) var(--page-horizontal);
  padding-bottom: calc(var(--spacing-sm) + env(safe-area-inset-bottom));
  background-color: var(--bg-white);
  border-top: 1rpx solid var(--border-light);
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  z-index: 100;
}

.reset-btn {
  font-size: 28rpx;
  color: var(--primary-color);
  flex-shrink: 0;
}

.result-count {
  flex: 1;
  font-size: 28rpx;
  color: var(--text-tertiary);
  text-align: center;
}

.apply-btn {
  flex-shrink: 0;
  padding: 24rpx 56rpx;
  background-color: var(--primary-color);
  color: #fff;
  border-radius: var(--radius-full);
  font-size: 30rpx;
  font-weight: 500;
  transition: opacity 0.2s ease;
}

.apply-btn:active {
  opacity: 0.92;
}