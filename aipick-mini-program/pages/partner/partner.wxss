/* pages/partner/partner.wxss - 搭子页样式 */

@import '../../styles/variables.wxss';
@import '../../styles/common.wxss';
@import '../../styles/match.wxss';

/* 顶部搜索栏 */
.top-bar {
  display: flex;
  align-items: center;
  padding: 20rpx 30rpx;
  background-color: var(--bg-white);
}

.search-box {
  flex: 1;
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
  background-color: var(--bg-gray);
  border-radius: var(--radius-full);
}

.search-box .search-icon {
  width: 32rpx;
  height: 32rpx;
  margin-right: 12rpx;
}

.search-box text {
  font-size: var(--font-base);
  color: var(--text-tertiary);
}

.filter-btn {
  margin-left: 20rpx;
  padding: 16rpx 24rpx;
  background-color: var(--primary-color);
  color: #fff;
  border-radius: var(--radius-full);
  font-size: var(--font-base);
}

/* 分类导航 */
.category-nav {
  background: var(--bg-white);
  white-space: nowrap;
  padding: 20rpx 30rpx;
  border-bottom: 1rpx solid var(--border-color);
}

.category-item {
  display: inline-block;
  padding: 12rpx 28rpx;
  font-size: var(--font-base);
  color: var(--text-secondary);
  margin-right: 16rpx;
  border-radius: var(--radius-full);
  background: var(--bg-gray);
}

.category-item.active {
  background: var(--primary-color);
  color: #fff;
}

/* 搭子列表 */
.partner-list {
  height: calc(100vh - 240rpx);
  padding: 20rpx;
  padding-bottom: var(--tab-bar-padding);
  box-sizing: border-box;
}

.partner-card {
  background: var(--bg-white);
  border-radius: var(--radius-lg);
  overflow: hidden;
  margin-bottom: 20rpx;
  box-shadow: var(--shadow-sm);
}

.partner-cover-wrap {
  position: relative;
  width: 100%;
  height: 260rpx;
  background: var(--bg-gray);
}

.partner-cover {
  width: 100%;
  height: 100%;
  display: block;
}

.partner-status-tag {
  position: absolute;
  top: 20rpx;
  right: 20rpx;
  padding: 8rpx 20rpx;
  font-size: var(--font-xs);
  border-radius: var(--radius-full);
  z-index: 2;
}

.partner-status-tag.recruiting {
  background: rgba(82, 196, 26, 0.95);
  color: #fff;
}

.partner-status-tag.full {
  background: rgba(255, 77, 79, 0.95);
  color: #fff;
}

.partner-status-tag.ended {
  background: rgba(0, 0, 0, 0.5);
  color: #fff;
}

.partner-card .partner-body {
  padding: 24rpx;
}

.partner-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.partner-category {
  display: inline-block;
  padding: 6rpx 16rpx;
  font-size: var(--font-xs);
  background: var(--secondary-color);
  color: var(--primary-color);
  border-radius: var(--radius-sm);
}

/* 状态标签 */
.status-tag {
  padding: 6rpx 16rpx;
  font-size: var(--font-xs);
  border-radius: var(--radius-sm);
}

.status-tag.recruiting {
  background: rgba(82, 196, 26, 0.1);
  color: var(--success-color);
}

.status-tag.full {
  background: rgba(255, 77, 79, 0.1);
  color: var(--error-color);
}

.status-tag.ended {
  background: var(--bg-gray);
  color: var(--text-tertiary);
}

.partner-time {
  font-size: var(--font-xs);
  color: var(--text-tertiary);
}

.partner-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 12rpx;
}

.partner-tags {
  display: flex;
  flex-wrap: wrap;
  margin-bottom: 12rpx;
}

.tag {
  display: inline-block;
  padding: 6rpx 14rpx;
  font-size: var(--font-xs);
  border-radius: var(--radius-sm);
  background: var(--bg-gray);
  color: var(--text-secondary);
  margin-right: 10rpx;
}

.partner-desc {
  font-size: var(--font-base);
  color: var(--text-secondary);
  line-height: 1.5;
  margin-bottom: 20rpx;
}

.partner-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 20rpx;
  border-top: 1rpx solid var(--border-color);
}

.author-info {
  display: flex;
  align-items: center;
}

.author-avatar {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  margin-right: 12rpx;
}

.author-name {
  font-size: var(--font-sm);
  color: var(--text-secondary);
}

.author-distance {
  font-size: var(--font-xs);
  color: var(--text-tertiary);
  margin-left: 8rpx;
}

/* 匹配度显示 */
.match-display {
  display: flex;
  align-items: center;
  background: linear-gradient(135deg, var(--accent-color) 0%, var(--accent-light) 100%);
  padding: 8rpx 16rpx;
  border-radius: var(--radius-full);
}

.match-num {
  font-size: var(--font-sm);
  font-weight: 600;
  color: #fff;
  margin-right: 4rpx;
}

.match-label {
  font-size: var(--font-xs);
  color: rgba(255, 255, 255, 0.9);
}

/* 成员信息 */
.member-info {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid var(--border-color);
}

.member-count {
  font-size: var(--font-sm);
  color: var(--text-secondary);
}

/* 发布按钮 */
.publish-btn {
  position: fixed;
  right: 30rpx;
  bottom: 100rpx;
  width: 100rpx;
  height: 100rpx;
  background: linear-gradient(135deg, var(--primary-color) 0%, var(--primary-light) 100%);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: var(--shadow-lg);
}

.publish-btn image {
  width: 48rpx;
  height: 48rpx;
}

/* 弹窗 */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: var(--bg-overlay);
  z-index: 100;
}

.modal-content {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: var(--bg-white);
  border-radius: var(--radius-xl) var(--radius-xl) 0 0;
  padding: 30rpx;
  padding-bottom: calc(30rpx + env(safe-area-inset-bottom));
  z-index: 101;
  max-height: 80vh;
  overflow-y: auto;
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 30rpx;
}

.modal-title {
  font-size: var(--font-lg);
  font-weight: 600;
  color: var(--text-primary);
}

.modal-close {
  width: 40rpx;
  height: 40rpx;
}

.form-item {
  margin-bottom: 24rpx;
}

.form-label {
  display: block;
  font-size: var(--font-base);
  color: var(--text-secondary);
  margin-bottom: 12rpx;
}

.form-input,
.picker-value {
  width: 100%;
  padding: 20rpx 24rpx;
  background: var(--bg-gray);
  border-radius: var(--radius-md);
  font-size: var(--font-base);
  box-sizing: border-box;
}

.form-textarea {
  width: 100%;
  padding: 20rpx 24rpx;
  background: var(--bg-gray);
  border-radius: var(--radius-md);
  font-size: var(--font-base);
  min-height: 150rpx;
  box-sizing: border-box;
}

.submit-btn {
  width: 100%;
  padding: 24rpx;
  background: var(--primary-color);
  color: #fff;
  font-size: var(--font-lg);
  text-align: center;
  border-radius: var(--radius-full);
  margin-top: 20rpx;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: var(--spacing-xl) 0;
}

.empty-state image {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 20rpx;
  opacity: 0.5;
}

.empty-state text {
  color: var(--text-tertiary);
  font-size: var(--font-base);
}

.loading {
  display: flex;
  justify-content: center;
  padding: var(--spacing-lg);
  color: var(--text-tertiary);
  font-size: var(--font-base);
}