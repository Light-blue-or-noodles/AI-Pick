<!--pages/partner/partner.wxml-->
<view class="container">
  <!-- 顶部搜索和筛选 -->
  <view class="top-bar">
    <view class="search-box" bindtap="goToFilter">
      <image class="search-icon" src="/images/search.png" mode="aspectFit" />
      <text>搜索搭子...</text>
    </view>
    <view class="filter-btn" bindtap="goToFilter">
      <text>筛选</text>
    </view>
  </view>

  <!-- 分类导航 -->
  <scroll-view class="category-nav" scroll-x>
    <view 
      class="category-item {{activeCategory === index ? 'active' : ''}}"
      wx:for="{{categories}}"
      wx:key="*this"
      bindtap="selectCategory"
      data-index="{{index}}"
    >
      {{item}}
    </view>
  </scroll-view>

  <!-- 搭子列表 -->
  <scroll-view class="partner-list" scroll-y wx:if="{{!isLoading}}">
    <block wx:for="{{partners}}" wx:key="id">
      <view class="partner-card" bindtap="goToDetail" data-id="{{item.id}}">
        <view class="partner-cover-wrap">
          <image class="partner-cover" src="{{item.cover}}" mode="aspectFill" />
          <view class="partner-status-tag {{item.status}}">
            {{item.statusLabel || (item.status === 'recruiting' ? '招募中' : (item.status === 'full' ? '已满' : '已结束'))}}
          </view>
        </view>
        <view class="partner-body">
          <view class="partner-header">
            <view class="partner-category">{{item.category}}</view>
          </view>
          <view class="partner-title">{{item.title}}</view>
          <view class="partner-tags">
            <text class="tag" wx:for="{{item.tags}}" wx:for-item="tag" wx:key="*this">{{tag}}</text>
          </view>
          <view class="partner-desc">{{item.description}}</view>
          <view class="partner-footer">
            <view class="author-info">
              <image class="author-avatar" src="{{item.author.avatar}}" mode="aspectFill" />
              <text class="author-name">{{item.author.name}}</text>
              <text class="author-distance" wx:if="{{item.distance}}">| {{item.distance}}</text>
            </view>
            <view class="match-display" wx:if="{{item.match}}">
              <text class="match-num">{{item.match}}%</text>
              <text class="match-label">匹配</text>
            </view>
          </view>
          <view class="member-info">
            <text class="member-count">👥 {{item.members}}/{{item.maxMembers}}人</text>
            <text class="partner-time">{{item.createTime}}</text>
          </view>
        </view>
      </view>
    </block>

    <!-- 空状态 -->
    <view class="empty-state" wx:if="{{partners.length === 0}}">
      <image src="/images/empty-partner.png" mode="aspectFit" />
      <text>暂无搭子信息</text>
    </view>
  </scroll-view>

  <!-- 加载中 -->
  <view class="loading" wx:else>
    <text>加载中...</text>
  </view>

  <!-- 发布按钮 -->
  <view class="publish-btn" bindtap="showPublishModal">
    <image src="/images/add.png" mode="aspectFit" />
  </view>

  <!-- 发布弹窗 -->
  <view class="modal-mask" wx:if="{{showPublishModal}}" bindtap="hidePublishModal"></view>
  <view class="modal-content" wx:if="{{showPublishModal}}">
    <view class="modal-header">
      <text class="modal-title">发布搭子</text>
      <image class="modal-close" src="/images/close.png" bindtap="hidePublishModal" />
    </view>
    <view class="modal-body">
      <view class="form-item">
        <text class="form-label">标题</text>
        <input class="form-input" placeholder="请输入标题" data-field="title" bindinput="updateForm" />
      </view>
      <view class="form-item">
        <text class="form-label">分类</text>
        <picker bindchange="onCategoryChange" value="{{categoryIndex}}" range="{{categories}}">
          <view class="picker-value">{{publishForm.category}}</view>
        </picker>
      </view>
      <view class="form-item">
        <text class="form-label">描述</text>
        <textarea class="form-textarea" placeholder="请输入详细描述" data-field="description" bindinput="updateForm" />
      </view>
      <view class="form-item">
        <text class="form-label">要求</text>
        <input class="form-input" placeholder="请输入要求" data-field="requirements" bindinput="updateForm" />
      </view>
      <view class="form-item">
        <text class="form-label">联系方式</text>
        <input class="form-input" placeholder="请输入联系方式" data-field="contact" bindinput="updateForm" />
      </view>
      <view class="submit-btn" bindtap="submitPartner">发布</view>
    </view>
  </view>
</view>