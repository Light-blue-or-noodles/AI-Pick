<!--pages/school/join/school-join.wxml-->
<view class="container">
  <!-- 页面标题 -->
  <view class="page-header">
    <text class="page-title">加入学校</text>
    <text class="page-subtitle">填写学校名称，加入校友组织</text>
  </view>

  <!-- 表单区域 -->
  <view class="form-section">
    <view class="form-item">
      <text class="form-label">学校名称</text>
      <input 
        class="form-input" 
        type="text" 
        placeholder="请输入学校全称" 
        value="{{schoolName}}"
        bindinput="onSchoolInput"
        maxlength="50"
      />
    </view>

    <!-- 提交按钮 -->
    <button 
      class="submit-btn" 
      bindtap="onSubmit"
      disabled="{{submitting}}"
      loading="{{submitting}}"
    >
      {{submitting ? '提交中...' : '确认加入'}}
    </button>
  </view>

  <!-- 已加入状态 -->
  <view class="status-section" wx:if="{{hasJoined}}">
    <view class="status-card">
      <image class="status-icon" src="/images/success.png" mode="aspectFit" />
      <text class="status-title">已加入学校</text>
      <text class="status-school">{{userSchool}}</text>
      <button class="change-btn" bindtap="onChangeSchool">更换学校</button>
    </view>
  </view>

  <!-- 提示信息 -->
  <view class="tips-section">
    <view class="tips-title">温馨提示</view>
    <view class="tips-item">• 学校名称请填写全称，确保准确</view>
    <view class="tips-item">• 加入后可在个人中心查看</view>
    <view class="tips-item">• 如需更换学校可重新提交</view>
  </view>
</view>
