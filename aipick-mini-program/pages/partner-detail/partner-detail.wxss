/* pages/partner-detail/partner-detail.wxss */

.container {
  min-height: 100vh;
  background: #F5F5F5;
  padding-bottom: 40rpx;
}

/* Header */
.header {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 24rpx;
  z-index: 100;
  background: transparent;
}

.back-btn,
.more-btn {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(0, 0, 0, 0.3);
  border-radius: 50%;
}

.back-icon,
.more-icon {
  color: #ffffff;
  font-size: 36rpx;
}

/* User Section */
.user-section {
  background: linear-gradient(180deg, #667EEA 0%, #764BA2 100%);
  padding: 180rpx 40rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.avatar {
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  border: 6rpx solid rgba(255, 255, 255, 0.5);
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.2);
}

.user-basic {
  margin-top: 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.nickname {
  font-size: 40rpx;
  font-weight: bold;
  color: #ffffff;
}

.user-meta {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-top: 8rpx;
}

/* Action Buttons */
.action-buttons {
  display: flex;
  justify-content: center;
  gap: 24rpx;
  padding: 40rpx 40rpx;
  background: #ffffff;
}

.btn-action {
  flex: 1;
  height: 80rpx;
  border-radius: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
}

.btn-following {
  background: #F5F5F5;
  color: #666666;
}

.btn-chat {
  background: linear-gradient(135deg, #FF6B35 0%, #FF8E53 100%);
  color: #ffffff;
}

.btn-match {
  background: linear-gradient(135deg, #FFB800 0%, #FFD93D 100%);
  color: #ffffff;
}

.btn-icon-text {
  font-weight: 500;
}

/* Section */
.section {
  margin-top: 20rpx;
  background: #ffffff;
  padding: 32rpx;
}

.section-header {
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1A1A1A;
}

.section-content {
  padding-left: 8rpx;
}

/* Bio */
.bio-text {
  font-size: 28rpx;
  color: #666666;
  line-height: 1.8;
}

/* Tags */
.tags {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.tag {
  padding: 12rpx 24rpx;
  background: rgba(255, 107, 53, 0.1);
  color: #FF6B35;
  border-radius: 32rpx;
  font-size: 26rpx;
}

/* Circle Item */
.circle-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #F5F5F5;
}

.circle-item:last-child {
  border-bottom: none;
}

.circle-icon {
  font-size: 36rpx;
  margin-right: 16rpx;
}

.circle-name {
  flex: 1;
  font-size: 28rpx;
  color: #333333;
}

.circle-status {
  font-size: 24rpx;
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
}

.circle-status.verified {
  background: rgba(46, 213, 115, 0.1);
  color: #2ED573;
}

.circle-status.pending {
  background: rgba(153, 153, 153, 0.1);
  color: #999999;
}

/* Partner Card */
.partner-card {
  background: #F9F9F9;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.partner-card:last-child {
  margin-bottom: 0;
}

.partner-card-header {
  margin-bottom: 12rpx;
}

.partner-card-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1A1A1A;
}

.partner-card-info {
  display: flex;
  gap: 24rpx;
  margin-bottom: 12rpx;
}

.partner-card-location,
.partner-card-members {
  font-size: 26rpx;
  color: #666666;
}

.partner-card-desc {
  font-size: 26rpx;
  color: #999999;
}

/* Loading */
.loading {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 100rpx 0;
  color: #999999;
  font-size: 28rpx;
}

/* Modal */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 200;
}

.more-menu {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #ffffff;
  border-radius: 24rpx 24rpx 0 0;
  z-index: 201;
  overflow: hidden;
}

.menu-item {
  height: 100rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  color: #333333;
  border-bottom: 1rpx solid #F5F5F5;
}

.menu-item:last-child {
  color: #999999;
}