/* pages/partner-detail/partner-detail.wxss */

.container {
  min-height: 100vh;
  background: #F5F5F5;
  padding-bottom: 40rpx;
}

/* Header（返回用小程序自带，仅保留更多） */
.header {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  height: 88rpx;
  padding-top: env(safe-area-inset-top);
  display: flex;
  align-items: center;
  justify-content: flex-end;
  padding-left: 24rpx;
  padding-right: 24rpx;
  z-index: 100;
  background: transparent;
}

.more-btn {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(0, 0, 0, 0.35);
  border-radius: 50%;
}

.more-icon {
  color: #ffffff;
  font-size: 36rpx;
}

/* User Section */
.user-section {
  background: linear-gradient(180deg, #667EEA 0%, #764BA2 100%);
  padding: 180rpx 40rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.avatar {
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  border: 6rpx solid rgba(255, 255, 255, 0.5);
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.2);
}

.user-basic {
  margin-top: 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.nickname {
  font-size: 40rpx;
  font-weight: bold;
  color: #ffffff;
}

.user-meta {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-top: 8rpx;
}

/* Action Buttons */
.action-buttons {
  display: flex;
  justify-content: center;
  gap: 24rpx;
  padding: 40rpx 40rpx;
  background: #ffffff;
}

.btn-action {
  flex: 1;
  height: 80rpx;
  border-radius: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
}

.btn-following {
  background: #F5F5F5;
  color: #666666;
}

.btn-chat {
  background: linear-gradient(135deg, var(--primary-color) 0%, var(--primary-light) 100%);
  color: #ffffff;
}

.btn-match {
  background: linear-gradient(135deg, #FFB800 0%, #FFD93D 100%);
  color: #ffffff;
}

.btn-icon-text {
  font-weight: 500;
}

/* Section */
.section {
  margin-top: 20rpx;
  background: #ffffff;
  padding: 32rpx;
}

.section-header {
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1A1A1A;
}

.section-content {
  padding-left: 8rpx;
}

/* Bio */
.bio-text {
  font-size: 28rpx;
  color: #666666;
  line-height: 1.8;
}

/* Tags */
.tags {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.tag {
  padding: 12rpx 24rpx;
  background: rgba(255, 107, 53, 0.1);
  color: var(--primary-color);
  border-radius: 32rpx;
  font-size: 26rpx;
}

/* Circle Item */
.circle-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #F5F5F5;
}

.circle-item:last-child {
  border-bottom: none;
}

.circle-icon {
  font-size: 36rpx;
  margin-right: 16rpx;
}

.circle-name {
  flex: 1;
  font-size: 28rpx;
  color: #333333;
}

.circle-status {
  font-size: 24rpx;
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
}

.circle-status.verified {
  background: rgba(46, 213, 115, 0.1);
  color: #2ED573;
}

.circle-status.pending {
  background: rgba(153, 153, 153, 0.1);
  color: #999999;
}

/* Partner Card */
.partner-card {
  background: #F9F9F9;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.partner-card:last-child {
  margin-bottom: 0;
}

.partner-card-header {
  margin-bottom: 12rpx;
}

.partner-card-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1A1A1A;
}

.partner-card-info {
  display: flex;
  gap: 24rpx;
  margin-bottom: 12rpx;
}

.partner-card-location,
.partner-card-members {
  font-size: 26rpx;
  color: #666666;
}

.partner-card-desc {
  font-size: 26rpx;
  color: #999999;
}

/* Loading */
.loading {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 100rpx 0;
  color: #999999;
  font-size: 28rpx;
}

/* Modal */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 200;
}

.more-menu {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #ffffff;
  border-radius: 24rpx 24rpx 0 0;
  z-index: 201;
  overflow: hidden;
}

.menu-item {
  height: 100rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  color: #333333;
  border-bottom: 1rpx solid #F5F5F5;
}

.menu-item:last-child {
  color: #999999;
}

.empty-detail {
  padding: 80rpx 40rpx;
  text-align: center;
  color: var(--text-tertiary, #999);
  font-size: var(--font-base, 28rpx);
}

/* 新版：横幅封面 + 信息 */
.hero {
  position: relative;
  height: 420rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
}

.hero-cover {
  width: 100%;
  height: 420rpx;
  display: block;
}

.hero-mask {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 24rpx 32rpx 32rpx;
  background: linear-gradient(transparent, rgba(0, 0, 0, 0.65));
}

.hero-more {
  position: absolute;
  top: 24rpx;
  right: 24rpx;
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(0, 0, 0, 0.35);
  border-radius: 50%;
}

.hero-title {
  display: block;
  font-size: 40rpx;
  font-weight: 600;
  color: #fff;
  margin-top: 48rpx;
}

.hero-sub {
  display: block;
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.9);
  margin-top: 12rpx;
}

.meta-card {
  margin: -24rpx 24rpx 0;
  padding: 24rpx 28rpx;
  background: #fff;
  border-radius: 16rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.06);
  position: relative;
  z-index: 2;
}

.meta-row {
  display: flex;
  justify-content: space-between;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
  font-size: 28rpx;
}

.meta-row:last-child {
  border-bottom: none;
}

.meta-k {
  color: #999;
}

.meta-v {
  color: #333;
  max-width: 460rpx;
  text-align: right;
}

.meta-row-pref {
  flex-direction: column;
  align-items: flex-start;
}

.meta-row-pref .meta-k {
  margin-bottom: 12rpx;
}

.pref-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  width: 100%;
}

.pref-chip {
  padding: 8rpx 20rpx;
  font-size: 24rpx;
  border-radius: 999rpx;
  background: rgba(82, 196, 26, 0.12);
  color: #389e0d;
}

.publisher {
  display: flex;
  align-items: center;
  padding: 32rpx 32rpx 0;
}

.pub-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  margin-right: 16rpx;
}

.pub-name {
  font-size: 30rpx;
  font-weight: 500;
  color: #333;
}

.section {
  margin: 24rpx 32rpx;
  padding: 24rpx;
  background: #fff;
  border-radius: 16rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 16rpx;
}

.section-body {
  font-size: 28rpx;
  color: #555;
  line-height: 1.6;
  white-space: pre-wrap;
}