/* pages/ai-chat/ai-chat.wxss */
@import '../../styles/variables.wxss';

.container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background-color: var(--bg-color);
}

/* 对话区域（左右对称，内容居中） */
.chat-list {
  flex: 1;
  padding: 24rpx 30rpx 140rpx 30rpx;
  padding-top: calc(24rpx + env(safe-area-inset-top));
  overflow-y: auto;
  box-sizing: border-box;
}

/* 欢迎提示（文案严格居中，避免靠右） */
.welcome-tip {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 40rpx 30rpx;
  width: 100%;
  box-sizing: border-box;
}

.welcome-img {
  width: 160rpx;
  height: 160rpx;
  margin-bottom: 30rpx;
}

.welcome-text-wrap,
.welcome-sub-wrap {
  width: 100%;
  display: flex;
  justify-content: center;
  align-items: center;
  margin-bottom: 16rpx;
}

.welcome-sub-wrap {
  margin-bottom: 0;
}

.welcome-text {
  font-size: 36rpx;
  color: #333;
  font-weight: 500;
  text-align: center;
}

.welcome-sub {
  font-size: 28rpx;
  color: #999;
  text-align: center;
}

/* 快捷入口（居中） */
.quick-actions {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  align-items: center;
  padding: 20px;
  gap: 10px;
  width: 100%;
  box-sizing: border-box;
}

.action-btn {
  padding: 8px 16px;
  background-color: #fff;
  border-radius: 20px;
  font-size: 14px;
  color: #333;
  border: 1rpx solid #eee;
  text-align: center;
}

/* 消息项 */
.message-item {
  display: flex;
  margin-bottom: 20px;
}

.message-item.user {
  justify-content: flex-end;
}

.message-item.ai {
  justify-content: flex-start;
}

.message-avatar {
  width: 72rpx;
  height: 72rpx;
  min-width: 72rpx;
  min-height: 72rpx;
  border-radius: 50%;
  flex-shrink: 0;
  background-color: #f0f0f0;
}

.user-avatar {
  margin-left: 16rpx;
}

.ai-avatar {
  margin-right: 16rpx;
  background-color: #e8f4fc;
}

.message-content {
  max-width: 70%;
  padding: 10px 14px;
  border-radius: 12px;
  font-size: 15px;
  line-height: 1.5;
}

.user-content {
  background-color: var(--primary-color);
  color: #fff;
  margin-left: 10px;
}

.ai-content {
  background-color: #fff;
  color: #333;
  margin-right: 10px;
}

/* 推荐区域 */
.recommend-section {
  margin-top: 12px;
  padding-top: 12px;
  border-top: 1rpx solid #eee;
}

.recommend-title {
  font-size: 13px;
  color: #999;
  margin-bottom: 10px;
}

.recommend-card {
  display: flex;
  align-items: center;
  padding: 10px;
  background-color: #f9f9f9;
  border-radius: 8px;
  margin-bottom: 8px;
}

.recommend-card:active {
  background-color: #f0f0f0;
}

.rec-avatar {
  width: 40px;
  height: 40px;
  border-radius: 8px;
  margin-right: 10px;
}

.rec-info {
  flex: 1;
}

.rec-name {
  font-size: 14px;
  color: #333;
  font-weight: 500;
}

.rec-desc {
  font-size: 12px;
  color: #999;
  margin-top: 2px;
}

.rec-match {
  padding: 4px 8px;
  background-color: var(--primary-color);
  color: #fff;
  font-size: 12px;
  border-radius: 10px;
}

/* 输入区域 */
.input-area {
  display: flex;
  align-items: center;
  padding: 10px 15px;
  background-color: #fff;
  border-top: 1rpx solid #eee;
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  z-index: 100;
}

.message-input {
  flex: 1;
  height: 36px;
  padding: 0 15px;
  background-color: #f5f5f5;
  border-radius: 18px;
  font-size: 14px;
}

.send-btn {
  margin-left: 10px;
  padding: 8px 16px;
  background-color: var(--primary-color);
  color: #fff;
  border-radius: 18px;
  font-size: 14px;
}

.send-btn:active {
  background-color: #e55a2b;
}