<!--pages/my-activity/my-activity.wxml - 标题使用导航栏，仅保留顶部右侧菜单 -->
<view class="container">
  <view class="header header-right-only">
    <view class="create-btn" bindtap="onGoToCreate">
      <text>发起</text>
    </view>
  </view>

  <!-- Tabs -->
  <view class="tabs">
    <view 
      class="tab {{activeTab === index ? 'active' : ''}}"
      wx:for="{{tabs}}"
      wx:key="*this"
      bindtap="onSwitchTab"
      data-index="{{index}}"
    >
      <text>{{item}}</text>
    </view>
  </view>

  <!-- Loading -->
  <view class="loading" wx:if="{{isLoading}}">
    <text>加载中...</text>
  </view>

  <!-- Activity List -->
  <view class="list" wx:else>
    <!-- All Tab -->
    <block wx:if="{{activeTab === 0}}">
      <view 
        class="activity-card"
        wx:for="{{allActivities}}"
        wx:key="id"
        bindtap="onViewDetail"
        data-id="{{item.id}}"
      >
        <image class="activity-cover" src="{{item.cover}}" mode="aspectFill" />
        <view class="activity-content">
          <view class="activity-header">
            <text class="activity-title">🎯 {{item.title}}</text>
            <text class="activity-status">{{item.statusText}}</text>
          </view>
          <view class="activity-info">
            <text class="info-item">📅 {{item.time}}</text>
            <text class="info-tag">🏷️ {{item.category}}</text>
          </view>
        </view>
      </view>
      
      <view class="empty-state" wx:if="{{allActivities.length === 0}}">
        <text>暂无活动</text>
      </view>
    </block>

    <!-- Joined Tab -->
    <block wx:if="{{activeTab === 1}}">
      <view 
        class="activity-card"
        wx:for="{{joinedActivities}}"
        wx:key="id"
        bindtap="onViewDetail"
        data-id="{{item.id}}"
      >
        <image class="activity-cover" src="{{item.cover}}" mode="aspectFill" />
        <view class="activity-content">
          <view class="activity-header">
            <text class="activity-title">🎯 {{item.title}}</text>
            <text class="activity-status">{{item.statusText}}</text>
          </view>
          <view class="activity-info">
            <text class="info-item">📅 {{item.time}}</text>
            <text class="info-tag">🏷️ {{item.category}}</text>
          </view>
        </view>
      </view>
      
      <view class="empty-state" wx:if="{{joinedActivities.length === 0}}">
        <text>暂无参加的活动</text>
      </view>
    </block>

    <!-- Published Tab -->
    <block wx:if="{{activeTab === 2}}">
      <view 
        class="activity-card"
        wx:for="{{publishedActivities}}"
        wx:key="id"
        bindtap="onViewDetail"
        data-id="{{item.id}}"
      >
        <image class="activity-cover" src="{{item.cover}}" mode="aspectFill" />
        <view class="activity-content">
          <view class="activity-header">
            <text class="activity-title">🎯 {{item.title}}</text>
            <text class="activity-status {{item.status}}">{{item.statusText}}</text>
          </view>
          <view class="activity-info">
            <text class="info-item">📅 {{item.time}}</text>
            <text class="info-tag">🏷️ {{item.category}}</text>
          </view>
          <view class="activity-stats" wx:if="{{item.currentParticipants}}">
            <text>👥 {{item.currentParticipants}}/{{item.maxParticipants}}人</text>
          </view>
        </view>
      </view>
      
      <view class="empty-state" wx:if="{{publishedActivities.length === 0}}">
        <text>暂无发起的活动</text>
      </view>
    </block>
  </view>
</view>