# 复制为 .env 并填写真实值，切勿提交 .env 到 Git
# 本文件放在 aipick-backend 目录下；启动时会自动加载（与 application.yml 中 ${WECHAT_SECRET:} 等对应）
DB_PASSWORD=请改为强密码
JWT_SECRET=请改为至少32位随机字符串
DASHSCOPE_API_KEY=你的百炼API-Key
# 微信登录必配：小程序 AppSecret（微信公众平台 - 开发管理 - 开发设置 - AppSecret）
# 不填会报「微信配置不完整，请在配置中设置 wechat.appid 与 wechat.secret」
WECHAT_APPID=wx4bdbaf380a183caa
WECHAT_SECRET=
