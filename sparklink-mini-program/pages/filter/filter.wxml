<!--pages/filter/filter.wxml-->
<view class="container">
  <!-- 筛选内容（标题已通过导航栏展示在顶部） -->
  <scroll-view class="filter-content" scroll-y>
    <!-- 距离筛选 -->
    <view class="filter-section">
      <view class="section-title">距离</view>
      <view class="filter-options">
        <view class="option-item {{distance === 'all' ? 'active' : ''}}"
              bindtap="selectDistance" data-value="all">不限</view>
        <view class="option-item {{distance === '1km' ? 'active' : ''}}"
              bindtap="selectDistance" data-value="1km">1km内</view>
        <view class="option-item {{distance === '3km' ? 'active' : ''}}"
              bindtap="selectDistance" data-value="3km">3km内</view>
        <view class="option-item {{distance === '5km' ? 'active' : ''}}"
              bindtap="selectDistance" data-value="5km">5km内</view>
        <view class="option-item {{distance === '10km' ? 'active' : ''}}"
              bindtap="selectDistance" data-value="10km">10km内</view>
      </view>
    </view>

    <!-- 性别筛选 -->
    <view class="filter-section">
      <view class="section-title">性别</view>
      <view class="filter-options">
        <view class="option-item {{gender === 'all' ? 'active' : ''}}"
              bindtap="selectGender" data-value="all">不限</view>
        <view class="option-item {{gender === 'male' ? 'active' : ''}}"
              bindtap="selectGender" data-value="male">男</view>
        <view class="option-item {{gender === 'female' ? 'active' : ''}}"
              bindtap="selectGender" data-value="female">女</view>
      </view>
    </view>

    <!-- 搭子类型筛选 -->
    <view class="filter-section">
      <view class="section-title">搭子类型</view>
      <view class="filter-options">
        <view class="option-item {{partnerType === 'all' ? 'active' : ''}}"
              bindtap="selectPartnerType" data-value="all">全部</view>
        <view class="option-item {{partnerType === 'game' ? 'active' : ''}}"
              bindtap="selectPartnerType" data-value="game">游戏</view>
        <view class="option-item {{partnerType === 'sports' ? 'active' : ''}}"
              bindtap="selectPartnerType" data-value="sports">运动</view>
        <view class="option-item {{partnerType === 'food' ? 'active' : ''}}"
              bindtap="selectPartnerType" data-value="food">美食</view>
        <view class="option-item {{partnerType === 'study' ? 'active' : ''}}"
              bindtap="selectPartnerType" data-value="study">学习</view>
        <view class="option-item {{partnerType === 'travel' ? 'active' : ''}}"
              bindtap="selectPartnerType" data-value="travel">旅行</view>
        <view class="option-item {{partnerType === 'other' ? 'active' : ''}}"
              bindtap="selectPartnerType" data-value="other">其他</view>
      </view>
    </view>

    <!-- 匹配度筛选 -->
    <view class="filter-section">
      <view class="section-title">匹配度</view>
      <view class="filter-options">
        <view class="option-item {{matchLevel === 'all' ? 'active' : ''}}"
              bindtap="selectMatchLevel" data-value="all">不限</view>
        <view class="option-item {{matchLevel === '90' ? 'active' : ''}}"
              bindtap="selectMatchLevel" data-value="90">90%以上</view>
        <view class="option-item {{matchLevel === '80' ? 'active' : ''}}"
              bindtap="selectMatchLevel" data-value="80">80%以上</view>
        <view class="option-item {{matchLevel === '70' ? 'active' : ''}}"
              bindtap="selectMatchLevel" data-value="70">70%以上</view>
      </view>
    </view>

    <!-- 搭子状态 -->
    <view class="filter-section">
      <view class="section-title">搭子状态</view>
      <view class="filter-options">
        <view class="option-item {{partnerStatus === 'all' ? 'active' : ''}}"
              bindtap="selectPartnerStatus" data-value="all">全部</view>
        <view class="option-item {{partnerStatus === 'recruiting' ? 'active' : ''}}"
              bindtap="selectPartnerStatus" data-value="recruiting">招募中</view>
        <view class="option-item {{partnerStatus === 'full' ? 'active' : ''}}"
              bindtap="selectPartnerStatus" data-value="full">已满</view>
      </view>
    </view>
  </scroll-view>

  <!-- 底部栏：左下角重置 + 结果数 + 右侧应用筛选 -->
  <view class="bottom-bar">
    <view class="reset-btn" bindtap="resetFilter">重置</view>
    <view class="result-count">找到 {{resultCount}} 个结果</view>
    <view class="apply-btn" bindtap="applyFilter">
      <text>应用筛选</text>
    </view>
  </view>
</view>
