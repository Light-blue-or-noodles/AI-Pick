<!--pages/account-security/account-security.wxml-->
<view class="container">
  <!-- Account Info -->
  <view class="section">
    <view class="section-title">账号信息</view>
    <view class="security-item" bindtap="onChangePhone">
      <text class="item-label">手机号</text>
      <view class="item-right">
        <text class="item-value">{{phone || '未绑定'}}</text>
        <image class="arrow-icon" src="/images/arrow-right.png" mode="aspectFit" />
      </view>
    </view>
    <view class="security-item" bindtap="onChangeEmail">
      <text class="item-label">邮箱</text>
      <view class="item-right">
        <text class="item-value">{{email || '未绑定'}}</text>
        <image class="arrow-icon" src="/images/arrow-right.png" mode="aspectFit" />
      </view>
    </view>
    <view class="security-item" bindtap="onToggleWeChat">
      <text class="item-label">微信绑定</text>
      <view class="item-right">
        <text class="item-value {{wechatBound ? 'bound' : ''}}">{{wechatBound ? '已绑定' : '未绑定'}}</text>
        <image class="arrow-icon" src="/images/arrow-right.png" mode="aspectFit" />
      </view>
    </view>
  </view>

  <!-- Security Settings -->
  <view class="section">
    <view class="section-title">安全设置</view>
    <view class="security-item" bindtap="onChangePassword">
      <text class="item-label">修改密码</text>
      <view class="item-right">
        <image class="arrow-icon" src="/images/arrow-right.png" mode="aspectFit" />
      </view>
    </view>
  </view>

  <!-- Login Info -->
  <view class="section">
    <view class="section-title">登录信息</view>
    <view class="security-item" bindtap="onViewDevices">
      <text class="item-label">登录设备管理</text>
      <view class="item-right">
        <image class="arrow-icon" src="/images/arrow-right.png" mode="aspectFit" />
      </view>
    </view>
    <view class="info-item">
      <text class="info-label">上次登录时间</text>
      <text class="info-value">{{lastLoginTime}}</text>
    </view>
    <view class="info-item">
      <text class="info-label">上次登录设备</text>
      <text class="info-value">{{lastLoginDevice}}</text>
    </view>
  </view>

  <!-- Danger Zone -->
  <view class="section danger">
    <view class="section-title">危险操作</view>
    <view class="danger-item" bindtap="onDeleteAccount">
      <text class="danger-label">注销账号</text>
      <view class="item-right">
        <image class="arrow-icon" src="/images/arrow-right.png" mode="aspectFit" />
      </view>
    </view>
  </view>

  <!-- Tips -->
  <view class="tips">
    <text class="tips-text">定期修改密码可以保护账号安全</text>
  </view>
</view>
