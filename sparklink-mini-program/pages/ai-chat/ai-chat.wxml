<!--pages/ai-chat/ai-chat.wxml - 标题使用导航栏，返回使用微信默认 -->
<view class="container">
  <!-- 对话区域 -->
  <scroll-view class="chat-list" scroll-y scroll-into-view="{{scrollIntoView}}" enhanced show-scrollbar="{{false}}">
    <block wx:for="{{messages}}" wx:key="id">
      <!-- 用户消息：气泡 + 用户头像（右侧） -->
      <view class="message-item user" id="msg-{{item.id}}">
        <view class="message-content user-content">
          <text>{{item.content}}</text>
        </view>
        <network-image class="message-avatar user-avatar" customClass="user-avatar" url="{{userInfo.avatar}}" defaultSrc="/images/default-avatar.png" mode="aspectFill" />
      </view>

      <!-- AI 消息：AI 默认头像（左侧）+ 气泡 -->
      <view class="message-item ai" id="msg-ai-{{item.id}}">
        <image class="message-avatar ai-avatar" src="/images/ai-icon.png" mode="aspectFill" />
        <view class="message-content ai-content">
          <text>{{item.reply}}</text>
          <!-- 推荐内容 -->
          <view class="recommend-section" wx:if="{{item.recommends && item.recommends.length > 0}}">
            <view class="recommend-title">为你推荐：</view>
            <block wx:for="{{item.recommends}}" wx:for-item="rec" wx:key="id">
              <view class="recommend-card" bindtap="goToDetail" data-type="{{rec.type}}" data-id="{{rec.id}}">
                <network-image class="rec-avatar" customClass="rec-avatar" url="{{rec.avatar}}" defaultSrc="/images/partner-banner.jpg" mode="aspectFill" />
                <view class="rec-info">
                  <text class="rec-name">{{rec.name}}</text>
                  <text class="rec-desc">{{rec.desc}}</text>
                </view>
                <view class="rec-match" wx:if="{{rec.match}}">{{rec.match}}%</view>
              </view>
            </block>
          </view>
        </view>
      </view>
    </block>

    <!-- 欢迎提示（整块居中） -->
    <view class="welcome-tip" wx:if="{{messages.length === 0}}">
      <image class="welcome-img" src="/images/ai-icon.png" mode="aspectFit" />
      <view class="welcome-text-wrap">
        <text class="welcome-text">你好！我是 AI 助手</text>
      </view>
      <view class="welcome-sub-wrap">
        <text class="welcome-sub">告诉我你想找什么样的搭子</text>
      </view>
    </view>

    <!-- 快捷入口（catchtap 避免被 scroll-view 拦截） -->
    <view class="quick-actions" wx:if="{{messages.length === 0}}">
      <view class="action-btn" catchtap="quickAsk" data-text="推荐一些游戏搭子">
        <text>🎮 游戏搭子</text>
      </view>
      <view class="action-btn" catchtap="quickAsk" data-text="推荐一些运动搭子">
        <text>🏃 运动搭子</text>
      </view>
      <view class="action-btn" catchtap="quickAsk" data-text="帮我推荐附近的搭子">
        <text>📍 附近搭子</text>
      </view>
    </view>
  </scroll-view>

  <!-- 输入区域 -->
  <view class="input-area">
    <input class="message-input" 
           placeholder="请输入你想找的搭子类型或偏好..." 
           value="{{inputValue}}"
           bindinput="onInput"
           bindconfirm="sendMessage"
           confirm-type="send"
           focus="{{inputFocus}}" />
    <view class="send-btn" bindtap="sendMessage">
      <text>发送</text>
    </view>
  </view>
</view>