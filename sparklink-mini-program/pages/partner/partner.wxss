/* pages/partner/partner.wxss - 搭子页样式 */

@import '../../styles/variables.wxss';
@import '../../styles/common.wxss';
@import '../../styles/match.wxss';

/* 本页容器：和首页一样底部留白，整页滚动时最后一条不被导航栏挡 */
.container {
  padding-bottom: var(--tab-bar-padding);
}

/* 吸顶头部：搜索栏 + 同事搭/校友搭/Pick搭 始终可见 */
.partner-header-fixed {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
  background: var(--bg-white);
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

/* 占位，避免列表顶到标签栏下（仅保留一行同事搭/校友搭/Pick搭时的高度） */
.partner-header-placeholder {
  height: calc(88rpx + env(safe-area-inset-top));
  flex-shrink: 0;
}

/* 顶部搜索栏 */
.top-bar {
  display: flex;
  align-items: center;
  padding: var(--spacing-sm) var(--page-horizontal);
  padding-top: calc(var(--spacing-sm) + env(safe-area-inset-top));
  background-color: var(--bg-white);
  border-bottom: 1rpx solid var(--border-light);
}

.search-box {
  flex: 1;
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
  background-color: var(--bg-gray);
  border-radius: var(--radius-full);
}

.search-box .search-icon {
  width: 32rpx;
  height: 32rpx;
  margin-right: 12rpx;
}

.search-box text {
  font-size: var(--font-base);
  color: var(--text-tertiary);
}

.filter-btn {
  margin-left: 20rpx;
  padding: 16rpx 24rpx;
  background-color: var(--primary-color);
  color: #fff;
  border-radius: var(--radius-full);
  font-size: var(--font-base);
}

/* 展示范围标签栏：同事搭 / 校友搭 / Pick搭（选中高亮+下划线） */
.scope-tabs {
  display: flex;
  align-items: center;
  padding: 0 var(--page-horizontal);
  padding-top: env(safe-area-inset-top);
  height: calc(88rpx + env(safe-area-inset-top));
  background: var(--primary-color);
  border-bottom: 1rpx solid var(--border-light);
  box-sizing: border-box;
}

.scope-tab {
  position: relative;
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 100%;
  padding: 0 8rpx;
}

.scope-tab-text {
  font-size: var(--font-base);
  color: rgba(255, 255, 255, 0.75);
  transition: color 0.2s ease;
}

.scope-tab.active .scope-tab-text {
  color: #fff;
  font-weight: 500;
}

.scope-tab-underline {
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 40rpx;
  height: 6rpx;
  border-radius: 3rpx;
  background: #fff;
}

/* 搭子列表：和首页一致，整页滚动，无固定高度；底部留白仅由 .container 提供，不重复 */
.partner-list {
  padding: 0 var(--page-horizontal);
  box-sizing: border-box;
}

.partner-card {
  background: var(--bg-white);
  border-radius: var(--radius-lg);
  overflow: hidden;
  margin-bottom: var(--card-gap);
  box-shadow: var(--shadow-sm);
  transition: opacity 0.2s ease;
}

.partner-card:active {
  opacity: 0.98;
}

.partner-cover-wrap {
  position: relative;
  width: 100%;
  height: 260rpx;
  background: var(--bg-gray);
}

.partner-cover {
  width: 100%;
  height: 100%;
  display: block;
}

.partner-status-tag {
  position: absolute;
  top: 20rpx;
  right: 20rpx;
  padding: 8rpx 20rpx;
  font-size: var(--font-xs);
  border-radius: var(--radius-full);
  z-index: 2;
}

.partner-status-tag.recruiting {
  background: rgba(82, 196, 26, 0.95);
  color: #fff;
}

.partner-status-tag.full {
  background: rgba(255, 77, 79, 0.95);
  color: #fff;
}

.partner-status-tag.ended {
  background: rgba(0, 0, 0, 0.5);
  color: #fff;
}

.partner-card .partner-body {
  padding: 24rpx;
}

.partner-header {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

/* 活动类型标签：主色底+白字，提升可读性 */
.partner-category {
  display: inline-block;
  padding: 8rpx 20rpx;
  font-size: var(--font-sm);
  font-weight: 500;
  background: var(--primary-color);
  color: #fff;
  border-radius: var(--radius-sm);
  max-width: 60%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  flex-shrink: 1;
  min-width: 0;
}

/* 与类型标签同一行、靠右；人数图标与数字同一行内垂直居中对齐 */
.partner-header .member-count {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: flex-end;
  gap: 8rpx;
  flex: 0 0 auto;
  min-height: 44rpx;
}

/* 人数：emoji 用 view 包裹便于与数字在交叉轴上对齐；图标略大于数字 */
.partner-header .member-count-ico {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 44rpx;
  height: 40rpx;
  font-size: 36rpx;
  line-height: 1;
}

.partner-header .member-count-num {
  font-size: 28rpx;
  line-height: 40rpx;
  color: var(--text-secondary);
  font-weight: 500;
  flex-shrink: 0;
}

/* 状态标签 */
.status-tag {
  padding: 6rpx 16rpx;
  font-size: var(--font-xs);
  border-radius: var(--radius-sm);
}

.status-tag.recruiting {
  background: rgba(82, 196, 26, 0.1);
  color: var(--success-color);
}

.status-tag.full {
  background: rgba(255, 77, 79, 0.1);
  color: var(--error-color);
}

.status-tag.ended {
  background: var(--bg-gray);
  color: var(--text-tertiary);
}

.partner-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 12rpx;
}

.partner-pref {
  font-size: var(--font-sm);
  color: var(--text-secondary);
  margin-bottom: 12rpx;
  line-height: 1.45;
}

.partner-tags {
  display: flex;
  flex-wrap: wrap;
  margin-bottom: 12rpx;
}

.tag {
  display: inline-block;
  padding: 6rpx 14rpx;
  font-size: var(--font-xs);
  border-radius: var(--radius-sm);
  background: var(--bg-gray);
  color: var(--text-secondary);
  margin-right: 10rpx;
}

.partner-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 20rpx;
  border-top: 1rpx solid var(--border-color);
}

.author-info {
  display: flex;
  align-items: center;
}

.author-avatar {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  margin-right: 12rpx;
}

.author-name {
  font-size: var(--font-sm);
  color: var(--text-secondary);
}

.author-distance {
  font-size: var(--font-xs);
  color: var(--text-tertiary);
  margin-left: 8rpx;
}

/* 匹配度显示 */
.match-display {
  display: flex;
  align-items: center;
  background: linear-gradient(135deg, var(--accent-color) 0%, var(--accent-light) 100%);
  padding: 8rpx 16rpx;
  border-radius: var(--radius-full);
}

.match-num {
  font-size: var(--font-sm);
  font-weight: 600;
  color: #fff;
  margin-right: 4rpx;
}

.match-label {
  font-size: var(--font-xs);
  color: rgba(255, 255, 255, 0.9);
}

/* 旧版底部 member-info 已合并到 .partner-header，此处由 .partner-header .member-count 统一样式 */

/* 发布按钮：方案 B 精致小胶囊，与活动页统一 */
.publish-btn {
  position: fixed;
  right: 32rpx;
  bottom: calc(178rpx + env(safe-area-inset-bottom));
  width: 62rpx;
  height: 62rpx;
  background: rgba(255, 255, 255, 0.96);
  border: 2rpx solid rgba(255, 255, 255, 0.9);
  border-radius: 9999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 3rpx 12rpx rgba(0, 0, 0, 0.10);
  backdrop-filter: blur(12rpx);
  z-index: 100;
}

.publish-btn-icon {
  font-size: 34rpx;
  font-weight: 500;
  color: var(--primary-color);
  line-height: 1;
}

/* 弹窗 */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: var(--bg-overlay);
  z-index: 100;
}

.modal-content {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: var(--bg-white);
  border-radius: var(--radius-xl) var(--radius-xl) 0 0;
  padding: 30rpx;
  padding-bottom: calc(30rpx + env(safe-area-inset-bottom));
  z-index: 101;
  max-height: 80vh;
  overflow-y: auto;
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 30rpx;
}

.modal-title {
  font-size: var(--font-lg);
  font-weight: 600;
  color: var(--text-primary);
}

.modal-close {
  width: 40rpx;
  height: 40rpx;
}

.form-item {
  margin-bottom: 24rpx;
}

.form-label {
  display: block;
  font-size: var(--font-base);
  color: var(--text-secondary);
  margin-bottom: 12rpx;
}

.form-input,
.picker-value {
  width: 100%;
  padding: 20rpx 24rpx;
  background: var(--bg-gray);
  border-radius: var(--radius-md);
  font-size: var(--font-base);
  box-sizing: border-box;
}

.form-textarea {
  width: 100%;
  padding: 20rpx 24rpx;
  background: var(--bg-gray);
  border-radius: var(--radius-md);
  font-size: var(--font-base);
  min-height: 150rpx;
  box-sizing: border-box;
}

.submit-btn {
  width: 100%;
  padding: 24rpx;
  background: var(--primary-color);
  color: #fff;
  font-size: var(--font-lg);
  text-align: center;
  border-radius: var(--radius-full);
  margin-top: 20rpx;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: var(--spacing-xl) 0;
}

.empty-state image {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 20rpx;
  opacity: 0.5;
}

.empty-state text {
  color: var(--text-tertiary);
  font-size: var(--font-base);
}

.loading {
  display: flex;
  justify-content: center;
  padding: var(--spacing-lg);
  color: var(--text-tertiary);
  font-size: var(--font-base);
}