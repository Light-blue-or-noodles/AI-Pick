<!--pages/login/login.wxml-->
<view class="login-container">
  <!-- Logo Area -->
  <view class="logo-area">
    <view class="logo">
      <image class="logo-img" src="/images/spark-link-logo.png" mode="aspectFit" />
    </view>
    <text class="app-name">Spark Link</text>
    <text class="app-slogan">AI 驱动的兴趣社交平台</text>
  </view>

  <!-- Login Buttons -->
  <view class="login-buttons">
    <!-- Phone Login Button -->
    <button 
      class="btn-phone btn-login" 
      bindtap="onPhoneLogin"
      disabled="{{isLoading}}"
    >
      <text class="btn-icon">📱</text>
      <text class="btn-text">手机号登录</text>
    </button>

    <!-- WeChat Login Button（仅点击登录，不重复绑定 getPhoneNumber 避免触发两次请求） -->
    <button 
      class="btn-wechat btn-login" 
      bindtap="onWechatLogin"
      disabled="{{isLoading}}"
    >
      <text class="btn-icon">👤</text>
      <text class="btn-text">微信一键登录</text>
    </button>
  </view>

  <!-- Agreement：复选框与整段协议一行显示 -->
  <view class="agreement-area">
    <view class="checkbox-wrapper" bindtap="toggleProtocol">
      <view class="checkbox {{agreeProtocol ? 'checked' : ''}}">
        <text class="check-icon" wx:if="{{agreeProtocol}}">✓</text>
      </view>
      <text class="agreement-text">我已阅读并同意<text class="link" catchtap="viewUserAgreement">《用户协议》</text>和<text class="link" catchtap="viewPrivacyPolicy">《隐私政策》</text></text>
    </view>
  </view>

  <!-- Loading -->
  <view class="loading-mask" wx:if="{{isLoading}}">
    <view class="loading-content">
      <view class="loading-spinner"></view>
      <text class="loading-text">登录中...</text>
    </view>
  </view>
</view>