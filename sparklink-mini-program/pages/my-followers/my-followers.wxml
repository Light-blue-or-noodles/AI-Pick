<!--pages/my-followers/my-followers.wxml — 样式与「我的关注」一致 -->
<view class="container">
  <view class="loading" wx:if="{{isLoading}}">
    <text>加载中...</text>
  </view>

  <view class="list" wx:else>
    <view class="user-card" wx:for="{{followersList}}" wx:key="id">
      <view class="user-info" bindtap="onViewProfile" data-id="{{item.id}}">
        <network-image
          class="user-avatar"
          customClass="user-avatar"
          url="{{item.avatar}}"
          defaultSrc="/images/default-avatar.png"
          mode="aspectFill"
          mediaKind="avatar"
        />
        <view class="user-detail">
          <text class="user-name">{{item.nickname || '用户'}}</text>
          <text class="user-bio" wx:if="{{item.bio}}">{{item.bio}}</text>
        </view>
      </view>
      <view class="user-actions">
        <view
          class="btn-chat"
          catchtap="onStartChat"
          data-id="{{item.id}}"
          data-nickname="{{item.nickname}}"
          data-avatar="{{item.avatar}}"
        >
          <text>💬</text>
        </view>
      </view>
    </view>

    <view class="empty-state" wx:if="{{followersList.length === 0}}">
      <image src="/images/empty-avatar.png" mode="aspectFit" />
      <text>暂无粉丝</text>
      <text class="empty-tip">多发搭子、多互动，更容易被看到～</text>
    </view>
  </view>
</view>
