/* pages/privacy-settings/privacy-settings.wxss */

.container {
  min-height: 100vh;
  background: #F5F5F5;
  padding-bottom: 40rpx;
}

/* Section */
.section {
  margin-top: 20rpx;
  background: #ffffff;
}

.section-title {
  font-size: 26rpx;
  color: #999999;
  padding: 20rpx 32rpx;
  background: #FAFAFA;
}

/* Privacy Item */
.privacy-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 100rpx;
  padding: 0 32rpx;
  border-bottom: 1rpx solid #F5F5F5;
  box-sizing: border-box;
}

.privacy-item:last-child {
  border-bottom: none;
}

.item-label {
  font-size: 30rpx;
  color: #333333;
  flex: 1;
}

.item-right {
  display: flex;
  align-items: center;
}

.item-value {
  font-size: 28rpx;
  color: #999999;
  margin-right: 12rpx;
}

.arrow-icon {
  width: 24rpx;
  height: 24rpx;
  flex-shrink: 0;
}

/* Tips */
.tips {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx 32rpx;
}

.tips-text {
  font-size: 26rpx;
  color: #999999;
}
