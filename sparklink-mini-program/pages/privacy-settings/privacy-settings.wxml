<!--pages/privacy-settings/privacy-settings.wxml-->
<view class="container">
  <!-- Permission Settings -->
  <view class="section">
    <view class="section-title">权限设置</view>
    <view class="privacy-item">
      <text class="item-label">谁可以找我聊天</text>
      <view class="item-right">
        <picker mode="selector" range="{{chatPermissionOptions}}" bindchange="onSetChatPermission">
          <text class="item-value">
            {{chatPermission === 'all' ? '全部' : chatPermission === 'friends' ? '好友' : '不允许'}}
          </text>
        </picker>
        <image class="arrow-icon" src="/images/arrow-right.png" mode="aspectFit" />
      </view>
    </view>
    <view class="privacy-item">
      <text class="item-label">谁可以看我的动态</text>
      <view class="item-right">
        <picker mode="selector" range="{{profileVisibilityOptions}}" bindchange="onSetProfileVisibility">
          <text class="item-value">
            {{profileVisibility === 'all' ? '全部' : profileVisibility === 'friends' ? '好友' : '仅自己'}}
          </text>
        </picker>
        <image class="arrow-icon" src="/images/arrow-right.png" mode="aspectFit" />
      </view>
    </view>
  </view>

  <!-- Visibility Settings -->
  <view class="section">
    <view class="section-title">可见性设置</view>
    <view class="privacy-item">
      <text class="item-label">允许通过搜索找到我</text>
      <switch 
        checked="{{searchable}}" 
        bindchange="onToggleSearchable"
        color="#5FB3A8"
      />
    </view>
    <view class="privacy-item">
      <text class="item-label">显示在线状态</text>
      <switch 
        checked="{{showOnlineStatus}}" 
        bindchange="onToggleOnlineStatus"
        color="#5FB3A8"
      />
    </view>
    <view class="privacy-item">
      <text class="item-label">显示最后在线时间</text>
      <switch 
        checked="{{showLastSeen}}" 
        bindchange="onToggleLastSeen"
        color="#5FB3A8"
      />
    </view>
  </view>

  <!-- Blacklist -->
  <view class="section">
    <view class="section-title">黑名单</view>
    <view class="privacy-item" bindtap="onViewBlockedUsers">
      <text class="item-label">已屏蔽的用户</text>
      <view class="item-right">
        <image class="arrow-icon" src="/images/arrow-right.png" mode="aspectFit" />
      </view>
    </view>
  </view>

  <!-- Data Management -->
  <view class="section">
    <view class="section-title">数据管理</view>
    <view class="privacy-item" bindtap="onClearFootprints">
      <text class="item-label">清除浏览足迹</text>
      <view class="item-right">
        <image class="arrow-icon" src="/images/arrow-right.png" mode="aspectFit" />
      </view>
    </view>
  </view>

  <!-- Tips -->
  <view class="tips">
    <text class="tips-text">隐私设置仅影响其他用户对你的可见范围</text>
  </view>
</view>
