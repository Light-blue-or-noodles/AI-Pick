/* pages/partner-detail/partner-detail.wxss */

.container {
  min-height: 100vh;
  background: #F5F5F5;
  padding-bottom: 40rpx;
}

/* Header（返回用小程序自带，仅保留更多） */
.header {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  height: 88rpx;
  padding-top: env(safe-area-inset-top);
  display: flex;
  align-items: center;
  justify-content: flex-end;
  padding-left: 24rpx;
  padding-right: 24rpx;
  z-index: 100;
  background: transparent;
}

.more-btn {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(0, 0, 0, 0.35);
  border-radius: 50%;
}

.more-icon {
  color: #ffffff;
  font-size: 36rpx;
}

/* User Section */
.user-section {
  background: linear-gradient(180deg, #667EEA 0%, #764BA2 100%);
  padding: 180rpx 40rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.avatar {
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  border: 6rpx solid rgba(255, 255, 255, 0.5);
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.2);
}

.user-basic {
  margin-top: 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.nickname {
  font-size: 40rpx;
  font-weight: bold;
  color: #ffffff;
}

.user-meta {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-top: 8rpx;
}

/* Action Buttons — 在 .detail-stack .card-surface 内，边距由 card 统一 */
.action-buttons {
  display: flex;
  justify-content: space-between;
  align-items: stretch;
  gap: 20rpx;
  padding: 24rpx 28rpx;
  box-sizing: border-box;
}

.btn-action {
  flex: 1;
  min-width: 0;
  height: 80rpx;
  border-radius: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  box-sizing: border-box;
}

/* 未关注：主色描边，易辨认 */
.btn-follow {
  background: #fff;
  color: var(--primary-color, #5fb3a8);
  border: 2rpx solid var(--primary-color, #5fb3a8);
  font-weight: 500;
}

/* 已关注：浅主色底 + 深字，避免与灰底页面融在一起 */
.btn-following {
  background: rgba(95, 179, 168, 0.22);
  color: #1f6b62;
  border: 2rpx solid rgba(95, 179, 168, 0.55);
  font-weight: 600;
}

.btn-chat {
  border: none;
  background: linear-gradient(135deg, var(--primary-color) 0%, var(--primary-light) 100%);
  color: #ffffff;
}

.btn-match {
  border: none;
  background: linear-gradient(135deg, #FFB800 0%, #FFD93D 100%);
  color: #ffffff;
}

.btn-icon-text {
  font-weight: 500;
}

/* 详情区块标题在下方 .section 中统一定义 */
.section-header {
  margin-bottom: 24rpx;
}

.section-content {
  padding-left: 8rpx;
}

/* Bio */
.bio-text {
  font-size: 28rpx;
  color: #666666;
  line-height: 1.8;
}

/* Tags */
.tags {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.tag {
  padding: 12rpx 24rpx;
  background: rgba(255, 107, 53, 0.1);
  color: var(--primary-color);
  border-radius: 32rpx;
  font-size: 26rpx;
}

/* Circle Item */
.circle-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #F5F5F5;
}

.circle-item:last-child {
  border-bottom: none;
}

.circle-icon {
  font-size: 36rpx;
  margin-right: 16rpx;
}

.circle-name {
  flex: 1;
  font-size: 28rpx;
  color: #333333;
}

.circle-status {
  font-size: 24rpx;
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
}

.circle-status.verified {
  background: rgba(46, 213, 115, 0.1);
  color: #2ED573;
}

.circle-status.pending {
  background: rgba(153, 153, 153, 0.1);
  color: #999999;
}

/* Partner Card */
.partner-card {
  background: #F9F9F9;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.partner-card:last-child {
  margin-bottom: 0;
}

.partner-card-header {
  margin-bottom: 12rpx;
}

.partner-card-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1A1A1A;
}

.partner-card-info {
  display: flex;
  gap: 24rpx;
  margin-bottom: 12rpx;
}

.partner-card-location,
.partner-card-members {
  font-size: 26rpx;
  color: #666666;
}

.partner-card-desc {
  font-size: 26rpx;
  color: #999999;
}

/* Loading */
.loading {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 100rpx 0;
  color: #999999;
  font-size: 28rpx;
}

/* Modal */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 200;
}

.more-menu {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #ffffff;
  border-radius: 24rpx 24rpx 0 0;
  z-index: 201;
  overflow: hidden;
}

.menu-item {
  height: 100rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  color: #333333;
  border-bottom: 1rpx solid #F5F5F5;
}

.menu-item:last-child {
  color: #999999;
}

.empty-detail {
  padding: 80rpx 40rpx;
  text-align: center;
  color: var(--text-tertiary, #999);
  font-size: var(--font-base, 28rpx);
}

/* 横幅封面：标题与图分层更清晰，信息区不再负边距叠在图上 */
.hero {
  position: relative;
  height: 400rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  overflow: hidden;
}

.hero-cover {
  width: 100%;
  height: 400rpx;
  display: block;
}

.hero-mask {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  top: 0;
  padding: 0;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  background: linear-gradient(
    180deg,
    rgba(0, 0, 0, 0.04) 0%,
    rgba(0, 0, 0, 0.15) 42%,
    rgba(0, 0, 0, 0.62) 100%
  );
}

.hero-more {
  position: absolute;
  top: calc(12rpx + env(safe-area-inset-top, 0px));
  right: 24rpx;
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(0, 0, 0, 0.4);
  border-radius: 50%;
  z-index: 2;
}

.hero-title-wrap {
  width: 100%;
  padding: 0 28rpx 36rpx;
  box-sizing: border-box;
}

.hero-title {
  display: block;
  max-width: 92%;
  font-size: 38rpx;
  font-weight: 600;
  color: #fff;
  line-height: 1.45;
  text-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.55);
}

/* 下方白卡片与头图统一左右边距，宽度一致 */
.detail-stack {
  position: relative;
  z-index: 2;
  margin: 20rpx 24rpx 0;
  padding-bottom: 32rpx;
}

.card-surface {
  width: 100%;
  box-sizing: border-box;
  background: #fff;
  border-radius: 16rpx;
  box-shadow: 0 6rpx 20rpx rgba(0, 0, 0, 0.06);
}

.meta-card {
  margin: 0;
  padding: 20rpx 28rpx 12rpx;
}

.meta-row {
  display: flex;
  justify-content: space-between;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
  font-size: 28rpx;
}

.meta-row:last-child {
  border-bottom: none;
}

.meta-k {
  color: #999;
}

.meta-v {
  color: #333;
  max-width: 460rpx;
  text-align: right;
}

.meta-row-pref {
  flex-direction: column;
  align-items: flex-start;
}

.meta-row-pref .meta-k {
  margin-bottom: 12rpx;
}

.pref-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  width: 100%;
}

.pref-chip {
  padding: 8rpx 20rpx;
  font-size: 24rpx;
  border-radius: 999rpx;
  background: rgba(82, 196, 26, 0.12);
  color: #389e0d;
}

.detail-stack .card-surface + .card-surface {
  margin-top: 20rpx;
}

.publisher {
  display: flex;
  align-items: center;
  padding: 24rpx 28rpx;
  min-height: 96rpx;
  box-sizing: border-box;
}

.pub-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.pub-name {
  flex: 1;
  min-width: 0;
  font-size: 30rpx;
  font-weight: 500;
  color: #333;
  line-height: 1.4;
}

.section {
  margin: 0;
  padding: 24rpx 28rpx 28rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 16rpx;
}

.section-body {
  font-size: 28rpx;
  color: #555;
  line-height: 1.65;
  white-space: pre-wrap;
  word-break: break-word;
}

/* AI 匹配度弹层 */
.match-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 400;
}

.match-panel {
  position: fixed;
  left: 48rpx;
  right: 48rpx;
  top: 50%;
  transform: translateY(-50%);
  /* 原 68vh，加长 1/5 */
  max-height: 81.6vh;
  background: #fff;
  border-radius: 24rpx;
  z-index: 401;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  box-shadow: 0 16rpx 48rpx rgba(0, 0, 0, 0.12);
}

.match-panel-hd {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 22rpx 28rpx 14rpx;
  border-bottom: 1rpx solid #f0f0f0;
  flex-shrink: 0;
}

.match-panel-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #1a1a1a;
}

.match-panel-close {
  width: 56rpx;
  height: 56rpx;
  line-height: 52rpx;
  text-align: center;
  font-size: 44rpx;
  color: #999;
}

/* 隐藏系统滚动条后仍预留一点右侧内边距，避免文字贴边；展示高度较原 360rpx / 46vh 加长 1/5 */
.match-panel-body {
  flex: 1;
  height: 432rpx;
  max-height: 55.2vh;
  box-sizing: border-box;
  width: 100%;
}

.match-scroll-inner {
  padding: 16rpx 12rpx 20rpx 24rpx;
  box-sizing: border-box;
}

.match-total {
  text-align: center;
  padding: 4rpx 0 20rpx;
}

.match-total-val {
  font-size: 72rpx;
  font-weight: 700;
  color: var(--primary-color, #5fb3a8);
}

.match-total-unit {
  font-size: 30rpx;
  color: #666;
  margin-left: 8rpx;
}

.match-dims {
  margin-bottom: 20rpx;
}

.match-dims-row {
  display: flex;
  flex-direction: row;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.match-dims-row .match-dim {
  flex: 1;
  min-width: 0;
}

.match-dim {
  padding: 14rpx 10rpx;
  background: #f7faf9;
  border-radius: 12rpx;
  text-align: center;
  box-sizing: border-box;
}

.match-dim--ai {
  width: 100%;
}

.match-dim .d-k {
  display: block;
  font-size: 22rpx;
  color: #999;
  margin-bottom: 8rpx;
}

.match-dim .d-v {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
}

.match-sec-t {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 12rpx;
}

.match-reason {
  margin-bottom: 18rpx;
}

.match-reason-t {
  font-size: 28rpx;
  color: #555;
  line-height: 1.55;
  white-space: pre-wrap;
  word-break: break-word;
}

.match-sug-wrap {
  margin-bottom: 4rpx;
  padding-bottom: 8rpx;
}

.match-sug {
  display: flex;
  margin-bottom: 12rpx;
  font-size: 26rpx;
  color: #666;
  line-height: 1.5;
}

.sug-idx {
  flex-shrink: 0;
  width: 40rpx;
  color: var(--primary-color, #5fb3a8);
  font-weight: 500;
}

.sug-t {
  flex: 1;
}

.match-panel-ft {
  flex-shrink: 0;
  padding: 10rpx 28rpx calc(12rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid #f0f0f0;
}

.match-btn-ok {
  width: 100%;
  height: 68rpx;
  line-height: 68rpx;
  text-align: center;
  background: var(--primary-color, #5fb3a8);
  color: #fff;
  font-size: 28rpx;
  font-weight: 500;
  border-radius: 34rpx;
  box-sizing: border-box;
}