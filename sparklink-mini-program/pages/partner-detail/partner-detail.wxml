<view class="container">
  <view class="loading" wx:if="{{isLoading}}">
    <text>加载中...</text>
  </view>

  <block wx:elif="{{!isLoading && partnerInfo}}">
    <view class="hero">
      <network-image class="hero-cover" customClass="hero-cover" url="{{partnerInfo.coverImage}}" defaultSrc="/images/partner-banner.jpg" mode="aspectFill" mediaKind="cover" />
      <view class="hero-mask">
        <view class="hero-more" bindtap="onShowMore"><text class="more-icon">⋮</text></view>
        <view class="hero-title-wrap">
          <text class="hero-title">{{partnerInfo.title}}</text>
        </view>
      </view>
    </view>

    <view class="detail-stack">
      <view class="meta-card card-surface">
        <view class="meta-row"><text class="meta-k">搭子类型</text><text class="meta-v">{{partnerInfo.typeName || '-'}}</text></view>
        <view class="meta-row meta-row-pref">
          <text class="meta-k">搭子偏好</text>
          <view class="pref-chips" wx:if="{{partnerInfo.preferenceTags && partnerInfo.preferenceTags.length}}">
            <text class="pref-chip" wx:for="{{partnerInfo.preferenceTags}}" wx:key="*this">{{item}}</text>
          </view>
          <text class="meta-v" wx:else>-</text>
        </view>
        <view class="meta-row"><text class="meta-k">可见范围</text><text class="meta-v">{{partnerInfo.scopeName}}</text></view>
        <view class="meta-row"><text class="meta-k">时间范围</text><text class="meta-v">{{partnerInfo.planTimeRangeDisplay || '未设置'}}</text></view>
        <view class="meta-row" wx:if="{{partnerInfo.location}}"><text class="meta-k">地点</text><text class="meta-v">{{partnerInfo.location}}</text></view>
      </view>

      <view class="publisher card-surface">
        <network-image class="pub-avatar" customClass="pub-avatar" url="{{partnerInfo.avatar}}" defaultSrc="/images/default-avatar.png" mode="aspectFill" mediaKind="avatar" />
        <text class="pub-name">{{partnerInfo.nickname}}</text>
      </view>

      <view class="action-buttons card-surface">
        <view class="btn-action btn-follow {{isFollowing ? 'btn-following' : ''}}" bindtap="onToggleFollow">
          <text>{{isFollowing ? '已关注' : '+关注'}}</text>
        </view>
        <view class="btn-action btn-chat" bindtap="onStartChat"><text>💬 聊天</text></view>
        <view class="btn-action btn-match" bindtap="onShowMatch"><text>🎯 匹配</text></view>
      </view>

      <view class="section card-surface">
        <view class="section-title">详情</view>
        <text class="section-body">{{partnerInfo.description}}</text>
      </view>
    </view>
  </block>

  <view class="empty-detail" wx:if="{{!isLoading && !partnerInfo}}">
    <text>搭子不存在或已删除</text>
  </view>

  <view class="modal-mask" wx:if="{{showMoreMenu}}" bindtap="onHideMore"></view>
  <view class="more-menu" wx:if="{{showMoreMenu}}">
    <view class="menu-item" bindtap="onNotInterested"><text>不感兴趣</text></view>
    <view class="menu-item" bindtap="onReport"><text>举报</text></view>
    <view class="menu-item" bindtap="onHideMore"><text>取消</text></view>
  </view>

  <!-- AI 匹配度（与 /api/ai/match-score 结果） -->
  <view class="match-mask" wx:if="{{showMatchPanel}}" catchtap="onCloseMatchPanel"></view>
  <view class="match-panel" wx:if="{{showMatchPanel && matchResult}}">
    <view class="match-panel-hd">
      <text class="match-panel-title">匹配度分析</text>
      <view class="match-panel-close" catchtap="onCloseMatchPanel">×</view>
    </view>
    <scroll-view class="match-panel-body" scroll-y show-scrollbar="{{false}}">
      <view class="match-scroll-inner">
        <view class="match-total">
          <text class="match-total-val">{{matchResult.totalScore != null ? matchResult.totalScore : '--'}}</text>
          <text class="match-total-unit">分</text>
        </view>
        <view class="match-dims">
          <view class="match-dims-row">
            <view class="match-dim">
              <text class="d-k">活动</text>
              <text class="d-v">{{matchResult.activityTagScore != null ? matchResult.activityTagScore : (matchResult.interestScore != null ? matchResult.interestScore : '—')}}</text>
            </view>
            <view class="match-dim">
              <text class="d-k">发布者</text>
              <text class="d-v">{{matchResult.publisherTagScore != null ? matchResult.publisherTagScore : '—'}}</text>
            </view>
            <view class="match-dim">
              <text class="d-k">位置</text>
              <text class="d-v">{{matchResult.locationScore != null ? matchResult.locationScore : '—'}}</text>
            </view>
          </view>
          <view class="match-dim match-dim--ai">
            <text class="d-k">AI</text>
            <text class="d-v">{{matchResult.aiScore != null ? matchResult.aiScore : '—'}}</text>
          </view>
        </view>
        <view class="match-reason" wx:if="{{matchResult.reason}}">
          <text class="match-sec-t">说明</text>
          <text class="match-reason-t">{{matchResult.reason}}</text>
        </view>
        <view class="match-sug-wrap" wx:if="{{matchResult.suggestions && matchResult.suggestions.length}}">
          <text class="match-sec-t">建议</text>
          <view class="match-sug" wx:for="{{matchResult.suggestions}}" wx:for-index="sidx" wx:key="sidx">
            <text class="sug-idx">{{sidx + 1}}.</text>
            <text class="sug-t">{{item}}</text>
          </view>
        </view>
      </view>
    </scroll-view>
    <view class="match-panel-ft">
      <view class="match-btn-ok" catchtap="onCloseMatchPanel">知道了</view>
    </view>
  </view>
</view>
