/* pages/company/join/company-join.wxss */
@import '../../../styles/variables.wxss';

.page {
  min-height: 100vh;
  background: var(--bg-color);
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
}

.content {
  padding: 32rpx var(--page-horizontal, 32rpx) 0;
  box-sizing: border-box;
}

.card {
  background: var(--bg-white);
  border-radius: var(--radius-lg, 24rpx);
  padding: 36rpx 32rpx;
  box-shadow: var(--shadow-sm);
  margin-bottom: 24rpx;
}

.form-card .field-label {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 20rpx;
}

.field-input {
  width: 100%;
  min-height: 96rpx;
  padding: 0 28rpx;
  box-sizing: border-box;
  background: var(--bg-gray);
  border-radius: 16rpx;
  font-size: 30rpx;
  color: var(--text-primary);
  border: 2rpx solid transparent;
  margin-bottom: 36rpx;
  text-align: center;
}

.field-input:focus {
  background: #fff;
  border-color: var(--primary-light);
}

.ph {
  color: var(--text-tertiary);
  text-align: center;
}

.btn-primary {
  width: 100%;
  height: 96rpx;
  padding: 0;
  line-height: normal;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, var(--primary-dark) 0%, var(--primary-color) 50%, var(--primary-light) 100%);
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: 48rpx;
  border: none;
  box-sizing: border-box;
}

.btn-primary::after {
  border: none;
}

.btn-primary[disabled] {
  opacity: 0.55;
}

.status-card {
  text-align: center;
  padding-top: 48rpx;
  padding-bottom: 40rpx;
}

.status-badge {
  width: 88rpx;
  height: 88rpx;
  line-height: 88rpx;
  margin: 0 auto 24rpx;
  background: var(--primary-bg);
  color: var(--primary-color);
  font-size: 44rpx;
  font-weight: 700;
  border-radius: 50%;
}

.status-heading {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-secondary);
  margin-bottom: 12rpx;
}

.status-name {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  color: var(--primary-dark);
  margin-bottom: 40rpx;
  padding: 0 16rpx;
  box-sizing: border-box;
}

.btn-outline {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 280rpx;
  height: 80rpx;
  padding: 0 40rpx;
  background: transparent;
  color: var(--primary-color);
  font-size: 28rpx;
  border: 2rpx solid var(--primary-color);
  border-radius: 40rpx;
}

.tips-card {
  padding: 32rpx;
}

.tips-heading {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text-primary);
  margin-bottom: 24rpx;
}

.tips-line {
  display: flex;
  align-items: flex-start;
  margin-bottom: 20rpx;
}

.tips-line:last-child {
  margin-bottom: 0;
}

.tips-num {
  flex-shrink: 0;
  width: 40rpx;
  height: 40rpx;
  line-height: 40rpx;
  margin-right: 16rpx;
  margin-top: 4rpx;
  text-align: center;
  font-size: 22rpx;
  font-weight: 600;
  color: #fff;
  background: linear-gradient(135deg, var(--primary-dark), var(--primary-color));
  border-radius: 50%;
}

.tips-text {
  flex: 1;
  font-size: 26rpx;
  color: var(--text-secondary);
  line-height: 1.55;
}
