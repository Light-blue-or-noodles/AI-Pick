/* 复用搭子列表页卡片样式 */
@import '../partner/partner.wxss';

.container {
  padding-bottom: var(--tab-bar-padding);
}

.my-partner-actions {
  display: flex;
  justify-content: flex-end;
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid var(--border-color);
}

.btn-delete-partner {
  padding: 14rpx 36rpx;
  font-size: 28rpx;
  border-radius: 32rpx;
  background: rgba(255, 77, 79, 0.12);
  color: #ff4d4f;
}

.loading {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 100rpx 0;
  color: #999999;
  font-size: 28rpx;
}
